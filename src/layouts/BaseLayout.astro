---
/**
 * BaseLayout
 *
 * Main site wrapper for all pages
 * Fetches global chrome data (navigation, footer, site settings)
 * Provides consistent SEO, navigation, and footer
 *
 * Visual Editing:
 * - Uses loadQuery() for draft-aware data fetching
 * - VisualEditing component enables click-to-edit overlays
 * - Controlled by PUBLIC_SANITY_VISUAL_EDITING_ENABLED env var
 */

import { VisualEditing } from "@sanity/astro/visual-editing";
import { ViewTransitions } from "astro:transitions";
import { loadQuery } from "../lib/sanity/loadQuery";
import { GLOBAL_CHROME_QUERY } from "../lib/sanity/queries";
import SeoHead from "../components/seo/SeoHead.astro";
import TopRibbon from "../components/sections/TopRibbon.astro";
import Navigation from "../components/sections/Navigation.astro";
import Footer from "../components/sections/Footer.astro";
import "../styles/global.css";

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

interface Props {
  title?: string;
  description?: string;
  seo?: any;
  class?: string;
}

const { title, description, seo, class: className } = Astro.props;

const { data: globalData } = await loadQuery({ query: GLOBAL_CHROME_QUERY });
const { site, nav, topRibbon, footer } = globalData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      seo={seo}
      siteSettings={site}
      title={title}
      description={description}
    >
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    </SeoHead>
    <ViewTransitions />
  </head>

  <body class="min-h-screen flex flex-col">
    {topRibbon?.enabled && <TopRibbon data={topRibbon} transition:persist />}

    <Navigation data={nav} siteName={site?.siteName} transition:persist />

    <main class={className} transition:animate="fade">
      <slot />
    </main>

    <Footer data={footer} transition:persist />

    <VisualEditing enabled={visualEditingEnabled} />
  </body>
</html>
