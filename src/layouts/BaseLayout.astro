---
/**
 * BaseLayout
 *
 * Main site wrapper for all pages
 * Fetches global chrome data (navigation, footer, site settings)
 * Provides consistent SEO, navigation, and footer
 *
 * Architecture Rules:
 * - Fetches global data once at layout level
 * - Passes data down to components
 * - Pages only fetch page-specific data
 *
 * Preview Mode:
 * - Static pages (prerender=true): Pass preview={false} explicitly
 * - SSR pages (prerender=false): Omit preview prop to auto-detect from cookies
 */

import { ViewTransitions } from "astro:transitions";
import { getSanityClient } from "../lib/sanity/client";
import { GLOBAL_CHROME_QUERY } from "../lib/sanity/queries";
import { isPreviewMode } from "../lib/preview/cookies";
import SeoHead from "../components/seo/SeoHead.astro";
import TopRibbon from "../components/sections/TopRibbon.astro";
import Navigation from "../components/sections/Navigation.astro";
import Footer from "../components/sections/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  seo?: any;
  class?: string;
  /**
   * Override preview mode detection.
   * - Pass `false` for static/prerendered pages
   * - Omit to auto-detect from cookies (SSR only)
   */
  preview?: boolean;
}

const { title, description, seo, class: className, preview: previewProp } = Astro.props;

// Determine preview mode:
// - If explicitly passed, use that value
// - Otherwise, try to detect from cookies (only works in SSR)
let preview = false;
if (typeof previewProp === "boolean") {
  preview = previewProp;
} else {
  // Only check cookies in SSR context (when not prerendering)
  try {
    preview = isPreviewMode(Astro.cookies);
  } catch {
    // Cookies not available (prerendered page) - default to no preview
    preview = false;
  }
}

const client = getSanityClient({ preview });

// Fetch global chrome data
const globalData = await client.fetch(GLOBAL_CHROME_QUERY);
const { site, nav, topRibbon, footer } = globalData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      seo={seo}
      siteSettings={site}
      title={title}
      description={description}
    >
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    </SeoHead>
    <ViewTransitions />
  </head>

  <body class="min-h-screen flex flex-col">
    {topRibbon?.enabled && <TopRibbon data={topRibbon} transition:persist />}

    <Navigation data={nav} siteName={site?.siteName} transition:persist />

    <main class={className} transition:animate="fade">
      <slot />
    </main>

    <Footer data={footer} transition:persist />
  </body>
</html>
