---
/**
 * RichText Component
 *
 * Sanity-aware wrapper for Portable Text rendering.
 * Uses the shared PortableText component and keeps styles scoped via .richtext.
 */

import PortableText from "../PortableText.astro";

interface Props {
  content?: any[];
  class?: string;
}

const { content, class: className } = Astro.props;

const classes = ["richtext", className].filter(Boolean).join(" ");
---

{content ? (
  <PortableText value={content} class={classes} />
) : (
  <div class={classes}>
    <slot />
  </div>
)}
