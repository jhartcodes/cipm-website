---
/**
 * SanityImage Component
 * 
 * Content Component (Sanity-aware)
 * Renders optimized images from Sanity CDN with responsive srcset
 * 
 * Architecture Rules:
 * - This IS allowed to import from lib/sanity
 * - Handles Sanity image objects
 * - Provides responsive, optimized images
 */

import { Image } from "astro:assets";
import { getImageUrl, getImageDimensions } from "../../lib/sanity/image";
import type { SanityImageSource } from '@sanity/image-url';

interface Props {
  image: SanityImageSource;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  quality?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  image,
  alt,
  width,
  height,
  sizes = "100vw",
  quality = 80,
  loading = "lazy",
  fetchpriority,
  class: className,
} = Astro.props;

// Don't render if no image or no asset reference
if (!image || !image.asset || !image.asset._ref) {
  return null;
}

// Get image dimensions from Sanity metadata
const dimensions = getImageDimensions(image);
const baseWidth = dimensions?.width;
const baseHeight = dimensions?.height;

const resolvedWidth = width ?? baseWidth;
const resolvedHeight = height ?? (resolvedWidth && baseWidth && baseHeight
  ? Math.round((resolvedWidth * baseHeight) / baseWidth)
  : baseHeight);

const inferSize = !resolvedWidth || !resolvedHeight;

// Sanity URL (Astro Image will handle optimization)
const src = getImageUrl(image, resolvedWidth ?? baseWidth, quality);
---

<Image
  src={src}
  alt={alt}
  width={resolvedWidth}
  height={resolvedHeight}
  inferSize={inferSize}
  sizes={sizes}
  quality={quality}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority ?? (loading === "eager" ? "high" : undefined)}
  class:list={["max-w-full h-auto", className]}
/>
