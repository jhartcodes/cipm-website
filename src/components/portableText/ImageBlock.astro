---
import { getImageUrl, getImageSrcSet, getImageDimensions } from "../../lib/sanity/image";

const { value } = Astro.props;

if (!value?.asset) {
  return null;
}

const url = getImageUrl(value, 800);
const srcSet = getImageSrcSet(value, [400, 800, 1200], 80);
const dims = getImageDimensions(value);
---

<figure class="my-6">
  <img
    src={url}
    srcset={srcSet}
    sizes="100vw"
    alt={value?.alt ?? ""}
    width={dims?.width}
    height={dims?.height}
    class="rounded-lg"
    loading="lazy"
    decoding="async"
  />
  {value?.caption && (
    <figcaption class="mt-2 text-sm text-gray-600 text-center">
      {value.caption}
    </figcaption>
  )}
</figure>
