---
import { Image } from "astro:assets";
import { getImageUrl, getImageDimensions } from "../../lib/sanity/image";

const { value } = Astro.props;

if (!value?.asset) {
  return null;
}

const dims = getImageDimensions(value);
const width = dims?.width ?? 800;
const height = dims?.height ?? 600;
const url = getImageUrl(value, width);
---

<figure class="my-6">
  <Image
    src={url}
    alt={value?.alt ?? ""}
    width={width}
    height={height}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="rounded-lg"
  />
  {value?.caption && (
    <figcaption class="mt-2 text-sm text-gray-600 text-center">
      {value.caption}
    </figcaption>
  )}
</figure>
