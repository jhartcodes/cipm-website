---
/**
 * ContactPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../layout/Section.astro";
import SecondaryHeroSection from "../sections/shared/SecondaryHeroSection.astro";
import ContactInfoSection from "../sections/contact/ContactInfoSection.astro";
import ContactFormSection from "../sections/contact/ContactFormSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";

interface Props {
  data?: any;
  ctaData?: any;
}

const { data, ctaData } = Astro.props;
---

<BaseLayout title="Contact Us" seo={data?.seo}>
  <SecondaryHeroSection title="Contact Us" />
  <Section size="lg">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <div>
        <ContactFormSection
          heading={data?.formHeading}
          description={data?.formDescription}
          buttonText={data?.submitButtonText}
          successMessage={data?.successMessage}
        />
      </div>
      <div>
        <ContactInfoSection
          heading={data?.contactHeading}
          address={data?.address}
          phone={data?.phone}
          email={data?.email}
          mapEmbedUrl={data?.mapEmbedUrl}
        />
      </div>
    </div>
  </Section>
  {ctaData && (
    <ContactCtaSection
      heading={ctaData.heading}
      subheading={ctaData.subheading}
      buttonText={ctaData.buttonText}
      buttonLink={ctaData.buttonLink}
    />
  )}
</BaseLayout>
