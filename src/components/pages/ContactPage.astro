---
/**
 * ContactPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../layout/Section.astro";
import Text from "../ui/Text.astro";
import ContactInfoSection from "../sections/contact/ContactInfoSection.astro";
import ContactFormSection from "../sections/contact/ContactFormSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";
import { buildMetaDescription } from "../../lib/seo";

interface Props {
  data?: any;
  ctaData?: any;
}

const { data, ctaData } = Astro.props;
const pageTitle = "Contact Us";
const pageDescription =
  buildMetaDescription([data?.formDescription, data?.contactHeading]) ||
  "Get in touch with CIPM to ask questions about property management services or request support.";
---

<BaseLayout title={pageTitle} seo={data?.seo} description={pageDescription}>
  <Section size="sm">
    <div class="max-w-3xl">
      <Text as="h1" variant="hero">
        {pageTitle}
      </Text>
    </div>

    <div class="mt-12 grid lg:grid-cols-2 gap-16 lg:gap-24">
      <div>
        <ContactFormSection
          heading={data?.formHeading}
          buttonText={data?.submitButtonText}
          successMessage={data?.successMessage}
        />
      </div>
      <div>
        <ContactInfoSection
          heading={data?.contactHeading}
          address={data?.address}
          phone={data?.phone}
          email={data?.email}
          mapEmbedUrl={data?.mapEmbedUrl}
        />
      </div>
    </div>
  </Section>
  {
    ctaData && (
      <ContactCtaSection
        heading={ctaData.heading}
        subheading={ctaData.subheading}
        buttonText={ctaData.buttonText}
        buttonLink={ctaData.buttonLink}
        backgroundImage={ctaData.backgroundImage}
      />
    )
  }
</BaseLayout>
