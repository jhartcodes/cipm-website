---
/**
 * ServicesPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../sections/shared/HeroSection.astro";
import IntroSection from "../sections/services/IntroSection.astro";
import ServicesListSection from "../sections/services/ServicesListSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";

interface Props {
  data?: any;
}

const { data } = Astro.props;
---

<BaseLayout title="Our Services" seo={data?.seo}>
  <HeroSection hero={data?.hero} defaultHeading="Our Services" />
  <IntroSection
    heading={data?.introHeading}
    content={data?.introContent}
  />
  <ServicesListSection services={data?.services} />
  {data?.showCta && (
    <ContactCtaSection
      heading={data?.ctaHeading}
      subheading={data?.ctaText}
      buttonText={data?.ctaButtonText}
      buttonLink={data?.ctaButtonLink}
    />
  )}
</BaseLayout>
