---
/**
 * ServicesPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SecondaryHeroSection from "../sections/shared/SecondaryHeroSection.astro";
import ServicesListSection from "../sections/services/ServicesListSection.astro";
import FaqSection from "../sections/about/FaqSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";
import { buildMetaDescription } from "../../lib/seo";

interface Props {
  data?: any;
  ctaData?: any;
}

const { data, ctaData } = Astro.props;
const pageTitle = data?.hero?.heading || "Our Services";
const pageDescription =
  buildMetaDescription([data?.hero?.subheading]) ||
  "Explore CIPM property management services and how we support buildings, boards, and communities.";
---

<BaseLayout title={pageTitle} seo={data?.seo} description={pageDescription}>
  <SecondaryHeroSection title={pageTitle} subtitle={data?.hero?.subheading} />
  <ServicesListSection services={data?.services} />
  <FaqSection heading={data?.faqHeading} faqs={data?.faqs} />
  {
    ctaData && (
      <ContactCtaSection
        heading={ctaData.heading}
        subheading={ctaData.subheading}
        buttonText={ctaData.buttonText}
        buttonLink={ctaData.buttonLink}
        backgroundImage={ctaData.backgroundImage}
      />
    )
  }
</BaseLayout>
