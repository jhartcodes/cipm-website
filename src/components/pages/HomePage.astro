---
/**
 * HomePage Component
 *
 * Receives data as props (fetched by the route)
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../sections/home/HeroSection.astro";
import IntroductionSection from "../sections/home/IntroductionSection.astro";
import WhoWeAreSection from "../sections/home/WhoWeAreSection.astro";
import WhatWeManageSection from "../sections/home/WhatWeManageSection.astro";
import WhatWeOfferSection from "../sections/home/WhatWeOfferSection.astro";
import TestimonialsSection from "../sections/home/TestimonialsSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";

interface Props {
  data?: any;
}

const { data } = Astro.props;
---

<BaseLayout title="Home" seo={data?.seo}>
  <HeroSection hero={data?.hero} />
  <IntroductionSection
    headline={data?.introductionHeadline}
    supportingText={data?.introductionText}
  />
  <WhoWeAreSection
    heading={data?.whoWeAreHeading}
    content={data?.whoWeAreContent}
    image={data?.whoWeAreImage}
  />
  <WhatWeManageSection
    heading={data?.whatWeManageHeading}
    content={data?.whatWeManageContent}
    propertyTypes={data?.propertyTypes}
  />
  <WhatWeOfferSection
    heading={data?.whatWeOfferHeading}
    intro={data?.whatWeOfferIntro}
    services={data?.featuredServices}
  />
  <TestimonialsSection
    heading={data?.testimonialsHeading}
    testimonials={data?.featuredTestimonials}
  />
  <ContactCtaSection
    heading={data?.contactHeading}
    subheading={data?.contactSubheading}
    buttonText={data?.contactButtonText}
    buttonLink={data?.contactButtonLink}
  />
</BaseLayout>
