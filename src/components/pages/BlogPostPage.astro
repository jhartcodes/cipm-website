---
/**
 * BlogPostPage Component
 *
 * Page assembly for individual blog posts.
 * Composes hero, featured image, content blocks, and back link.
 * Uses Section's containerSize prop - do not nest another Container.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import BlogPostHeroSection from "../sections/blog/BlogPostHeroSection.astro";
import BlogPostFeaturedImage from "../sections/blog/BlogPostFeaturedImage.astro";
import BlogBlocks from "../content/BlogBlocks.astro";
import {
  buildArticleStructuredData,
  buildBreadcrumbStructuredData,
  buildMetaDescription,
} from "../../lib/seo";

interface Props {
  post: any;
}

const { post } = Astro.props;
const siteUrl = (
  Astro.site?.toString() || new URL("/", Astro.url).toString()
).replace(/\/$/, "");
const pageDescription =
  buildMetaDescription([post?.excerpt, post?.content]) ||
  `${post?.title || "Blog post"} article from CIPM.`;
const structuredData = [
  buildBreadcrumbStructuredData([
    { name: "Home", item: `${siteUrl}/` },
    { name: "Blog", item: `${siteUrl}/blog` },
    { name: post?.title || "Blog Post", item: Astro.url.toString() },
  ]),
  buildArticleStructuredData({
    headline: post?.title,
    description: pageDescription,
    url: Astro.url.toString(),
    publishedAt: post?.publishedAt,
    image: post?.featuredImage,
    authorName: post?.author,
    publisherId: `${siteUrl}#organization`,
  }),
].filter(Boolean);
---

<BaseLayout
  title={post.title}
  seo={post.seo}
  description={pageDescription}
  structuredData={structuredData}
>
  <BlogPostHeroSection
    title={post.title}
    category={post.category}
    author={post.author}
    publishedAt={post.publishedAt}
  />

  <BlogPostFeaturedImage
    image={post.featuredImage}
    alt={post.featuredImage?.alt || post.title}
  />

  <Section size="md" containerSize="narrow">
    {
      post.content &&
        Array.isArray(post.content) &&
        post.content.length > 0 && (
          <article class="richtext">
            <BlogBlocks blocks={post.content} />
          </article>
        )
    }

    <div class="mt-16 pt-8 border-t border-gray-200">
      <Button href="/blog" variant="outline" size="md">
        &larr; Back to Blog
      </Button>
    </div>
  </Section>
</BaseLayout>
