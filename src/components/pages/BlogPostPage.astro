---
/**
 * BlogPostPage Component
 *
 * Page assembly for individual blog posts.
 * Composes hero, featured image, content blocks, and back link.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../layout/Container.astro";
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import BlogPostHeroSection from "../sections/blog/BlogPostHeroSection.astro";
import BlogPostFeaturedImage from "../sections/blog/BlogPostFeaturedImage.astro";
import BlogBlocks from "../content/BlogBlocks.astro";

interface Props {
  post: any;
  preview?: boolean;
}

const { post, preview = false } = Astro.props;
---

<BaseLayout title={post.title} seo={post.seo} preview={preview}>
  <BlogPostHeroSection
    title={post.title}
    category={post.category}
    author={post.author}
    publishedAt={post.publishedAt}
  />

  <BlogPostFeaturedImage
    image={post.featuredImage}
    alt={post.featuredImage?.alt || post.title}
  />

  <Section size="lg">
    <Container class="max-w-3xl">
      {post.content && Array.isArray(post.content) && post.content.length > 0 && (
        <article class="richtext">
          <BlogBlocks blocks={post.content} />
        </article>
      )}

      <div class="mt-16 pt-8 border-t border-gray-200">
        <Button href="/blog" variant="outline" size="md">
          &larr; Back to Blog
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
