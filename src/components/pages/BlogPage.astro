---
/**
 * BlogPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SecondaryHeroSection from "../sections/shared/SecondaryHeroSection.astro";
import BlogIntroSection from "../sections/blog/BlogIntroSection.astro";
import BlogGridSection from "../sections/blog/BlogGridSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";
import { buildMetaDescription } from "../../lib/seo";

interface Props {
  data?: any;
  ctaData?: any;
  posts?: any[];
  currentPage?: number;
  totalPages?: number;
}

const {
  data,
  ctaData,
  posts = [],
  currentPage = 1,
  totalPages = 1,
} = Astro.props;
const pageTitle = data?.hero?.heading || "Blog";
const pageDescription =
  buildMetaDescription([data?.intro, data?.hero?.subheading]) ||
  "Read articles from CIPM about property management, operations, and community-focused service.";
---

<BaseLayout title={pageTitle} seo={data?.seo} description={pageDescription}>
  <SecondaryHeroSection title={pageTitle} subtitle={data?.hero?.subheading} />
  <BlogIntroSection heading={data?.heading} intro={data?.intro} />
  <div transition:name="blog-grid" transition:animate="initial">
    <BlogGridSection
      posts={posts}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </div>

  {
    ctaData && (
      <ContactCtaSection
        heading={ctaData.heading}
        subheading={ctaData.subheading}
        buttonText={ctaData.buttonText}
        buttonLink={ctaData.buttonLink}
        backgroundImage={ctaData.backgroundImage}
      />
    )
  }
</BaseLayout>
