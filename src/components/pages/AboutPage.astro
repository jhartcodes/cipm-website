---
/**
 * AboutPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SecondaryHeroSection from "../sections/shared/SecondaryHeroSection.astro";
import AboutStorySections from "../sections/about/AboutStorySections.astro";
import TeamSection from "../sections/about/TeamSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";

interface Props {
  data?: any;
  ctaData?: any;
}

const { data, ctaData } = Astro.props;
const pageTitle = data?.hero?.heading || "About Us";
---

<BaseLayout title={pageTitle} seo={data?.seo}>
  <SecondaryHeroSection
    title={pageTitle}
    subtitle={data?.hero?.subheading}
  />
  <AboutStorySections sections={data?.storySections} />
  <TeamSection
    eyebrow={data?.teamEyebrow}
    heading={data?.teamHeading}
    intro={data?.teamIntro}
    sidebarTitle={data?.teamSidebarTitle}
    sidebarContent={data?.teamSidebarContent}
    image={data?.teamImage}
    members={data?.teamMembers}
  />
  {
    ctaData && (
      <ContactCtaSection
        heading={ctaData.heading}
        subheading={ctaData.subheading}
        buttonText={ctaData.buttonText}
        buttonLink={ctaData.buttonLink}
      />
    )
  }
</BaseLayout>
