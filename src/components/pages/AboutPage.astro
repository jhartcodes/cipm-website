---
/**
 * AboutPage Component
 *
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import SecondaryHeroSection from "../sections/shared/SecondaryHeroSection.astro";
import SplitSection from "../sections/about/SplitSection.astro";
import StatementSection from "../sections/about/StatementSection.astro";
import TeamSection from "../sections/about/TeamSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";
import { buildMetaDescription } from "../../lib/seo";

interface Props {
  data?: any;
  ctaData?: any;
}

const { data, ctaData } = Astro.props;
const pageTitle = data?.hero?.heading || "About Us";
const pageDescription =
  buildMetaDescription([data?.hero?.subheading, data?.communityIntro]) ||
  "Learn about CIPM, our community focus, and the team behind our property management services.";
---

<BaseLayout title={pageTitle} seo={data?.seo} description={pageDescription}>
  <SecondaryHeroSection title={pageTitle} subtitle={data?.hero?.subheading} />

  {/* Our Story Section */}
  <SplitSection
    headline={data?.ourStoryHeadline}
    content={data?.ourStoryContent}
    image={data?.ourStoryImage}
    imageSide={data?.ourStoryImageSide || "right"}
    tone="default"
  />

  {/* Experience Section */}
  <SplitSection
    headline={data?.experienceHeadline}
    content={data?.experienceContent}
    image={data?.experienceImage}
    imageSide={data?.experienceImageSide || "left"}
    tone="muted"
  />

  {/* Statement Section with animation */}
  <StatementSection text={data?.statementText} />

  <TeamSection
    communityEyebrow={data?.communityEyebrow}
    communityHeading={data?.communityHeading}
    communityIntro={data?.communityIntro}
    communityImage={data?.communityImage}
    teamHeading={data?.teamHeading}
    teamIntro={data?.teamIntro}
    members={data?.teamMembers}
  />
  {
    ctaData && (
      <ContactCtaSection
        heading={ctaData.heading}
        subheading={ctaData.subheading}
        buttonText={ctaData.buttonText}
        buttonLink={ctaData.buttonLink}
        backgroundImage={ctaData.backgroundImage}
      />
    )
  }
</BaseLayout>
