---
/**
 * AboutPage Component
 *
 * Shared component for both production and preview routes.
 * Receives data as props (fetched by the route).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../sections/shared/HeroSection.astro";
import OurStorySection from "../sections/about/OurStorySection.astro";
import TeamSection from "../sections/about/TeamSection.astro";
import FaqSection from "../sections/about/FaqSection.astro";
import ContactCtaSection from "../sections/shared/ContactCtaSection.astro";

interface Props {
  data?: any;
  ctaData?: any;
  preview?: boolean;
}

const { data, ctaData, preview = false } = Astro.props;
---

<BaseLayout title="About Us" seo={data?.seo} preview={preview}>
  <HeroSection hero={data?.hero} defaultHeading="About Us" />
  <OurStorySection
    heading={data?.ourStoryHeading}
    content={data?.ourStoryContent}
    image={data?.ourStoryImage}
  />
  <TeamSection
    heading={data?.teamHeading}
    intro={data?.teamIntro}
    members={data?.teamMembers}
  />
  <FaqSection
    heading={data?.faqHeading}
    faqs={data?.faqs}
  />
  {ctaData && (
    <ContactCtaSection
      heading={ctaData.heading}
      subheading={ctaData.subheading}
      buttonText={ctaData.buttonText}
      buttonLink={ctaData.buttonLink}
    />
  )}
</BaseLayout>
