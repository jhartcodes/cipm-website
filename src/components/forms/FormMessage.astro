---
/**
 * FormMessage Component
 *
 * UI Primitive for form success/error messages
 * Used for contact form feedback
 */

import Icon from "../ui/Icon.astro";

type MessageType = 'success' | 'error' | 'info';

interface Props {
  type: MessageType;
  message: string;
  class?: string;
}

const { type, message, class: className } = Astro.props;

const typeStyles = {
  success: 'bg-green-50 border-green-200 text-green-800',
  error: 'bg-red-50 border-red-200 text-red-800',
  info: 'bg-blue-50 border-blue-200 text-blue-800',
};

const iconColors = {
  success: 'text-green-600',
  error: 'text-red-600',
  info: 'text-blue-600',
};

// Map message types to icon names
const iconNames = {
  success: 'check-circle' as const,
  error: 'cross' as const,
  info: 'link' as const, // Using link as placeholder for info icon
};
---

<div
  class:list={[
    'p-4 rounded-lg border',
    typeStyles[type],
    className,
  ]}
  role="alert"
>
  <div class="flex items-center gap-3">
    <span class:list={['flex-shrink-0', iconColors[type]]}>
      <Icon name={iconNames[type]} size={24} />
    </span>
    <p class="text-sm font-medium">{message}</p>
  </div>
</div>
