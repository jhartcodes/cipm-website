---
/**
 * FormMessage Component
 * 
 * UI Primitive for form success/error messages
 * Used for contact form feedback
 */

type MessageType = 'success' | 'error' | 'info';

interface Props {
  type: MessageType;
  message: string;
  class?: string;
}

const { type, message, class: className } = Astro.props;

const typeStyles = {
  success: 'bg-green-50 border-green-200 text-green-800',
  error: 'bg-red-50 border-red-200 text-red-800',
  info: 'bg-blue-50 border-blue-200 text-blue-800',
};

const icons = {
  success: '✓',
  error: '✕',
  info: 'ℹ',
};
---

<div
  class:list={[
    'p-4 rounded-lg border',
    typeStyles[type],
    className,
  ]}
  role="alert"
>
  <div class="flex items-center gap-3">
    <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center font-bold">
      {icons[type]}
    </span>
    <p class="text-sm font-medium">{message}</p>
  </div>
</div>
