---
/**
 * TextArea Component
 * 
 * UI Primitive for multi-line text input
 * Styled for CIPM brand
 */

interface Props {
  name: string;
  label: string;
  required?: boolean;
  minLength?: number;
  maxLength?: number;
  placeholder?: string;
  value?: string;
  rows?: number;
  error?: string;
  class?: string;
}

const {
  name,
  label,
  required = false,
  minLength,
  maxLength,
  placeholder,
  value,
  rows = 4,
  error,
  class: className,
} = Astro.props;

const textareaId = `field-${name}`;
const errorId = `error-${name}`;
---

<div class={className}>
  <label for={textareaId} class="block text-sm font-semibold text-navy mb-2">
    {label}
    {required && <span class="text-red-500 ml-1">*</span>}
  </label>

  <textarea
    id={textareaId}
    name={name}
    rows={rows}
    placeholder={placeholder}
    required={required}
    minlength={minLength}
    maxlength={maxLength}
    aria-required={required}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? errorId : undefined}
    class:list={[
      'w-full px-4 py-3 rounded-xl border',
      'text-gray-900 placeholder-gray-400',
      'focus:outline-none focus:border-turquoise focus:ring-2 focus:ring-turquoise/20',
      'transition-all resize-y min-h-[150px]',
      error
        ? 'border-red-500'
        : 'border-gray-300 hover:border-gray-400',
    ]}
  >{value}</textarea>

  {error && (
    <p id={errorId} class="mt-2 text-sm text-red-600" role="alert">
      {error}
    </p>
  )}
</div>
