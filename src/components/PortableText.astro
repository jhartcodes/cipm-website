---
/**
 * PortableText Component
 *
 * Centralized renderer for Sanity Portable Text
 */

import { PortableText } from "astro-portabletext";
import ImageBlock from "./portableText/ImageBlock.astro";
import LinkMark from "./portableText/LinkMark.astro";

interface Props {
  value?: any[];
  class?: string;
}

const { value, class: className } = Astro.props;

const components = {
  types: {
    image: ImageBlock,
  },
  marks: {
    link: LinkMark,
  },
};
---

<div class={className}>
  <PortableText value={value ?? []} components={components} />
</div>
