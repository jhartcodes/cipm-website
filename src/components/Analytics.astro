---
/**
 * Google Analytics component for Astro with View Transitions
 *
 * Handles page view tracking on both:
 * - Initial page load
 * - Client-side navigation (View Transitions)
 */

const GA_MEASUREMENT_ID = "G-6N8PVH2KNN";
---

<!-- Google tag (gtag.js) -->
<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
  // Initialize dataLayer
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', GA_MEASUREMENT_ID, { send_page_view: false });

  // Track page view function
  function trackPageView() {
    gtag('event', 'page_view', {
      page_title: document.title,
      page_location: window.location.href,
      page_path: window.location.pathname
    });
  }

  // Track on View Transitions navigation
  document.addEventListener('astro:page-load', trackPageView);
</script>

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
