---
import Container from './Container.astro';

type SectionSize = 'sm' | 'md' | 'lg';
type SectionTone = 'default' | 'muted' | 'inverted';
type ContainerSize = 'narrow' | 'base' | 'wide';

interface Props {
  size?: SectionSize;
  tone?: SectionTone; // background color: default (white), muted (gray), inverted (navy)
  containerSize?: ContainerSize;
  bleed?: boolean; // removes max-width constraint
  id?: string;
  class?: string;
}

const {
  size = 'md',
  tone = 'default',
  containerSize = 'base',
  bleed = false,
  id,
  class: className,
} = Astro.props;

const sizeClasses: Record<SectionSize, string> = {
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16 lg:py-20',
  lg: 'py-16 md:py-24 lg:py-32',
};

const toneClasses: Record<SectionTone, string> = {
  default: 'bg-white',
  muted: 'bg-[var(--color-gray-50)]',
  inverted: 'bg-[var(--color-navy)] text-white',
};

const classes = [
  sizeClasses[size],
  toneClasses[tone],
  className,
].filter(Boolean).join(' ');
---

<section id={id} class={classes}>
  <Container size={containerSize} bleed={bleed}>
    <slot />
  </Container>
</section>
