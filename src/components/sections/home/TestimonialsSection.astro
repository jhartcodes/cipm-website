---
/**
 * TestimonialsSection Component
 *
 * Displays client testimonials in a grid.
 * Uses Section's built-in Container - do not nest another Container.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Testimonial {
  quote?: string;
  authorName?: string;
  authorTitle?: string;
  image?: any;
}

interface Props {
  heading?: string;
  testimonials?: Testimonial[];
}

const { heading, testimonials = [] } = Astro.props;
---

<Section size="md" tone="default">
  <Text
    as="h2"
    variant="headingLg"
    align="center"
    class="mb-12 text-3xl md:text-4xl font-bold text-navy"
  >
    {heading || "What Our Clients Say"}
  </Text>

  {
    testimonials.length > 0 && (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((item) => (
          <div class="bg-white rounded-2xl p-8 shadow-lg relative group">
            <span
              class="absolute -top-4 left-8 text-6xl text-turquoise/20 font-serif transition-colors group-hover:text-navy/80"
              aria-hidden="true"
            >
              "
            </span>

            {item.quote && (
              <Text
                as="p"
                variant="body"
                class=" text-gray-700 leading-relaxed italic"
              >
                "{item.quote}"
              </Text>
            )}

            <div class="mt-6 pt-6 border-t border-gray-100">
              {item.authorName && (
                <Text as="p" variant="body" class="font-semibold text-navy">
                  {item.authorName}
                </Text>
              )}
              {item.authorTitle && (
                <Text as="p" variant="small" class="text-sm text-gray-500">
                  {item.authorTitle}
                </Text>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</Section>
