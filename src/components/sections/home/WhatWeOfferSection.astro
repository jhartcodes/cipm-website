---
/**
 * WhatWeOfferSection Component
 *
 * Displays a split layout with image on the left and service list on the right.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import SanityImage from "../../content/SanityImage.astro";

interface ServiceItem {
  title?: string;
  shortDescription?: string;
  icon?: any;
}

interface Props {
  heading?: string;
  intro?: string;
  image?: any;
  services?: ServiceItem[];
}

const { heading, intro, image, services = [] } = Astro.props;

// Default SVG icon paths (fallback when no Sanity icon)
const defaultIcons = [
  "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z", // Calculator
  "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4", // Building
  "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", // Document
  "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z", // Users
];
---

<Section size="lg">
  <div class="text-center space-y-4 mb-12">
    <p class="text-turquoise font-bold tracking-wide uppercase text-sm">
      {heading || "What We Offer"}
    </p>
    <Text
      as="h2"
      class="text-2xl md:text-3xl font-bold text-navy leading-tight max-w-3xl mx-auto"
    >
      {intro || "Develop a title here"}
    </Text>
  </div>

  <div class="grid gap-8 lg:grid-cols-2 lg:gap-10 items-start lg:items-stretch">
    <div class="w-full h-full">
      {
        image ? (
          <div class="rounded-lg overflow-hidden shadow-lg w-full h-full">
            <div class="aspect-4/3 min-h-55 lg:aspect-auto lg:h-full">
              <SanityImage
                image={image}
                alt={image?.alt || heading || "What We Offer"}
                width={1200}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        ) : (
          <div class="rounded-lg bg-gray-200 aspect-4/3 min-h-55 lg:aspect-auto lg:h-full" />
        )
      }
    </div>

    <div class="p-1 md:p-2 h-full flex flex-col">
      {
        services.length > 0 && (
          <div class="space-y-5 flex-1">
            {services.slice(0, 4).map((service, index) => (
              <div class="border-b border-gray-200 pb-5 last:border-b-0 last:pb-0">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 flex items-center justify-center text-navy shrink-0">
                    {service.icon?.asset ? (
                      <SanityImage
                        image={service.icon}
                        alt=""
                        width={24}
                        class="w-6 h-6"
                      />
                    ) : (
                      <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d={defaultIcons[index % defaultIcons.length]}
                        />
                      </svg>
                    )}
                  </div>
                  {service.title && (
                    <h3 class="text-lg font-bold text-navy leading-tight">
                      {service.title}
                    </h3>
                  )}
                </div>

                {service.shortDescription && (
                  <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                    {service.shortDescription}
                  </p>
                )}
              </div>
            ))}
          </div>
        )
      }

      <div class="mt-8">
        <Button href="/services" variant="primary">View our services</Button>
      </div>
    </div>
  </div>
</Section>
