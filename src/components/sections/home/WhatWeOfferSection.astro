---
/**
 * WhatWeOfferSection Component
 *
 * Displays featured services in a 4-column grid with icons.
 * Variant C style from ServiceCardsFourUp prototype.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import SanityImage from "../../content/SanityImage.astro";

interface ServiceItem {
  title?: string;
  shortDescription?: string;
  icon?: any;
}

interface Props {
  heading?: string;
  intro?: string;
  services?: ServiceItem[];
}

const { heading, intro, services = [] } = Astro.props;

// Default SVG icon paths (fallback when no Sanity icon)
const defaultIcons = [
  "M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z", // Calculator
  "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4", // Building
  "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", // Document
  "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z", // Users
];
---

<Section size="md">
  {/* Header */}
  <div class="text-center mb-8">
    {/* Eyebrow */}
    <p class="text-turquoise font-bold tracking-wide uppercase text-sm mb-3">
      {heading || "What We Offer"}
    </p>

    {/* Headline */}
    <Text
      as="h2"
      class="text-2xl md:text-3xl font-bold text-navy leading-tight"
    >
      {intro || "Develop a title here"}
    </Text>
  </div>

  {/* Service Cards Grid */}
  {
    services.length > 0 && (
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map((service, index) => (
          <div class="bg-white rounded-lg p-6 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-200 border border-gray-200">
            {/* Icon */}
            <div class="w-12 h-12 rounded-lg bg-navy flex items-center justify-center mb-4">
              {service.icon?.asset ? (
                <SanityImage
                  image={service.icon}
                  alt=""
                  width={24}
                  class="w-6 h-6"
                />
              ) : (
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={defaultIcons[index % defaultIcons.length]}
                  />
                </svg>
              )}
            </div>

            {/* Title */}
            {service.title && (
              <h3 class="text-lg font-bold text-navy mb-2">{service.title}</h3>
            )}

            {/* Description */}
            {service.shortDescription && (
              <p class="text-sm text-gray-600 leading-relaxed">
                {service.shortDescription}
              </p>
            )}
          </div>
        ))}
      </div>
    )
  }

  {/* View All Services Button */}
  <div class="mt-8 text-center">
    <Button href="/services" variant="primary"> View our services </Button>
  </div>
</Section>
