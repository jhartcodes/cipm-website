---
/**
 * WhoWeAreSection Component
 *
 * Centered text block with heading, content, and image below.
 * Variant C style from TextBlockCentered prototype.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Props {
  heading?: string;
  content?: any[];
  image?: any;
}

const { heading, content, image } = Astro.props;
---

<Section size="lg">
  <div class="grid gap-8 lg:grid-cols-2 items-start">
    <div class="text-left">
      <div class="space-y-4">
        <Text as="h2" class="text-2xl md:text-3xl font-bold text-navy leading-tight">
          {heading || "Who We Are"}
        </Text>

        {
          content && (
            <div class="text-base text-gray-600 leading-relaxed space-y-4">
              <RichText content={content} />
            </div>
          )
        }
      </div>
    </div>

    {
      image && (
        <div class="rounded-lg overflow-hidden shadow-lg w-full">
          <div class="aspect-4/3 min-h-55 lg:max-h-120">
            <SanityImage
              image={image}
              alt={image?.alt || ""}
              width={1200}
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      )
    }
  </div>
</Section>
