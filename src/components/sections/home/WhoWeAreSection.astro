---
/**
 * WhoWeAreSection Component
 *
 * Two-column section with heading, content, and image.
 * Uses Section's built-in Container - do not nest another Container.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Props {
  heading?: string;
  content?: any[];
  image?: any;
}

const { heading, content, image } = Astro.props;
---

<Section size="lg">
  <div class="grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <Text as="h2" variant="headingLg">
          {heading || "Who We Are"}
        </Text>

        {content && (
          <div class="mt-4">
            <RichText content={content} />
          </div>
        )}
      </div>

      {image && (
        <SanityImage
          image={image}
          alt={image?.alt || ""}
          width={700}
          class="w-full rounded-lg shadow-lg"
        />
      )}
    </div>
</Section>
