---
/**
 * WhoWeAreSection Component
 *
 * Centered text block with heading, content, and image below.
 * Variant C style from TextBlockCentered prototype.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Props {
  heading?: string;
  content?: any[];
  image?: any;
}

const { heading, content, image } = Astro.props;
---

<Section size="md">
  {/* Centered text content */}
  <div class="text-center mx-auto">
    {/* Eyebrow */}
    <p class="text-turquoise font-bold tracking-wide uppercase text-sm mb-3">
      {heading || "Who We Are"}
    </p>

    {/* Headline */}
    <Text as="h2" class="text-2xl md:text-3xl font-bold text-navy leading-tight">
      Develop a title here
    </Text>

    {
      content && (
        <div class="mt-4 text-base text-gray-600 leading-relaxed">
          <RichText content={content} />
        </div>
      )
    }
  </div>

  {/* Image below */}
  {
    image && (
      <div class="mt-8 rounded-lg overflow-hidden shadow-lg max-w-3xl mx-auto">
        <div class="aspect-[21/9]">
          <SanityImage
            image={image}
            alt={image?.alt || ""}
            width={1200}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    )
  }
</Section>
