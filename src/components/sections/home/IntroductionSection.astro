---
/**
 * IntroductionSection Component
 *
 * Sits directly below the hero. Displays a headline and optional
 * supporting text. Variant C style: turquoise background, white text,
 * compact spacing.
 */

import Container from "../../layout/Container.astro";
import Text from "../../ui/Text.astro";

interface Props {
  headline?: string;
  supportingText?: string;
}

const { headline, supportingText } = Astro.props;

if (!headline) return;
---

<section class="py-12 lg:py-16 bg-turquoise">
  <Container size="wide">
    <div>
      <Text as="h2" variant="headingLg" tone="inverted">
        {headline}
      </Text>

      {
        supportingText && (
          <p class="mt-3 text-base text-white/90 max-w-xl">{supportingText}</p>
        )
      }
    </div>
  </Container>
</section>
