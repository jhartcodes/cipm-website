---
/**
 * IntroductionSection Component
 *
 * Sits directly below the hero. Displays a headline and optional
 * supporting text. Variant C style: turquoise background, white text,
 * compact spacing.
 */

import Text from "../../ui/Text.astro";
import Section from "../../layout/Section.astro";

interface Props {
  headline?: string;
  supportingText?: string;
  showTopGradient?: boolean;
}

const { headline, supportingText, showTopGradient = true } = Astro.props;

if (!headline) return;
---

<Section
  size="sm"
  containerSize="wide"
  class="relative overflow-visible !bg-turquoise"
>
  {
    showTopGradient && (
      <div
        class="pointer-events-none absolute inset-x-0 -top-28 h-48 bg-gradient-to-t from-turquoise/100 via-turquoise-light/25 to-transparent blur-2xl"
        aria-hidden="true"
      />
    )
  }

  <div class="relative z-10">
    <div>
      <Text as="h2" variant="headingLg" tone="inverted">
        {headline}
      </Text>

      {
        supportingText && (
          <p class="mt-4 text-base text-white/90 max-w-xl">{supportingText}</p>
        )
      }
    </div>
  </div>
</Section>
