---
/**
 * WhatWeManageSection Component
 *
 * Displays property types managed by CIPM in a responsive grid.
 * Uses Section's built-in Container - do not nest another Container.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";
import SanityImage from "../../content/SanityImage.astro";

interface PropertyType {
  title?: string;
  slug?: { current: string };
  icon?: any;
  image?: any;
  enableDetailPage?: boolean;
}

interface Props {
  heading?: string;
  content?: any[];
  propertyTypes?: PropertyType[];
}

const { heading, content, propertyTypes = [] } = Astro.props;

// Filter out null/undefined entries
const validPropertyTypes = propertyTypes.filter((pt) => pt != null);
---

<Section size="lg">
  <div class="text-center max-w-2xl mx-auto">
    <Text as="h2" variant="headingLg">
      {heading || "What We Manage"}
    </Text>

    {content && (
      <div class="mt-4">
        <RichText content={content} />
      </div>
    )}
  </div>

  {validPropertyTypes.length > 0 && (
    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
      {validPropertyTypes.map((item) => (
        <div class="group relative rounded-xl md:rounded-2xl overflow-hidden shadow-md hover:shadow-lg transition-shadow aspect-[3/4]">
          {/* Image */}
          {item.image ? (
            <SanityImage
              image={item.image}
              alt={item.image?.alt || item.title || ""}
              width={400}
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-navy to-navy-dark" />
          )}

          {/* Gradient overlay */}
          <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/40 to-transparent" />

          {/* Content overlay */}
          <div class="absolute bottom-0 left-0 right-0 p-3 md:p-4">
            {/* Title */}
            {item.title && (
              <Text as="h3" variant="body" tone="inverted" class="font-semibold">
                {item.title}
              </Text>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</Section>
