---
/**
 * HeroSection Component (Home)
 *
 * Full-height hero with navy background and decorative turquoise element.
 * Uses Section's built-in Container - do not nest another Container.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";

interface Props {
  hero?: {
    heading?: string;
    subheading?: string;
    backgroundImage?: any;
    ctaText?: string;
    ctaLink?: any;
  };
}

const { hero } = Astro.props;
---

<Section
  id="hero-section"
  size="md"
  tone="inverted"
  class="relative overflow-hidden min-h-[60vh] flex"
>
  <div
    class="absolute bottom-0 right-0 w-2/3 h-1/2 bg-turquoise/20 transform skew-y-6 translate-y-1/4"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10">
    <div class="max-w-3xl">
      <Text as="h1" variant="hero" tone="inverted">
        {hero?.heading || "Welcome to CIPM"}
      </Text>

      {
        hero?.subheading && (
          <Text as="p" variant="bodyLg" class="mt-4 text-white/80">
            {hero.subheading}
          </Text>
        )
      }

      {
        hero?.ctaText && hero?.ctaLink && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button href={hero.ctaLink} variant="outlineWhite" size="md">
              {hero.ctaText}
            </Button>
          </div>
        )
      }
    </div>
  </div>
</Section>
