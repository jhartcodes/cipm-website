---
/**
 * HeroSection Component (Home)
 *
 * Full-height hero with navy background and decorative turquoise element.
 * Uses Section's built-in Container - do not nest another Container.
 */

import { Image } from "astro:assets";
import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import CubeHouse from "../../../assets/cube-house.svg";

interface Props {
  hero?: {
    heading?: string;
    subheading?: string;
    ctaText?: string;
    ctaLink?: any;
  };
}

const { hero } = Astro.props;
---

<Section
  id="hero-section"
  size="md"
  tone="inverted"
  class="relative overflow-hidden sm:min-h-[30vh] lg:min-h-[70vh] max-h-200 flex"
>
  <div
    class="absolute bottom-0 right-0 w-2/3 h-1/2 bg-turquoise/20 transform skew-y-6 translate-y-1/4"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10">
    <div class="max-w-3xl mx-auto">
      <Text as="h1" variant="hero" tone="inverted">
        {hero?.heading || "Welcome to CIPM"}
      </Text>

      {
        hero?.subheading && (
          <Text as="p" variant="bodyLg" class="mt-4 text-white/80">
            {hero.subheading}
          </Text>
        )
      }

      {
        hero?.ctaText && hero?.ctaLink && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <Button href={hero.ctaLink} variant="outlineWhite" size="md">
              {hero.ctaText}
            </Button>
          </div>
        )
      }
    </div>
  </div>

  <Image
    src={CubeHouse}
    alt=""
    aria-hidden="true"
    class="hero-cube"
    loading="eager"
    width={384}
    height={384}
  />
</Section>

<style>
  .hero-cube {
    display: none;
    position: absolute;
    right: -4%;
    bottom: calc(-6% + 80px);
    width: 10rem;
    opacity: 0.9;
    pointer-events: none;
    transform-origin: center;
    animation: cube-enter 1.2s ease-out both;
  }

  @media (min-width: 768px) {
    .hero-cube {
      display: block;
      width: 11.5rem;
      bottom: calc(-8% + 80px);
    }
  }

  @media (min-width: 1024px) {
    .hero-cube {
      width: 18rem;
      bottom: calc(-10% + 80px);
    }
  }

  @keyframes cube-enter {
    0% {
      transform: translate(30%, -10%) rotate(-40deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cube {
      animation: none;
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>
