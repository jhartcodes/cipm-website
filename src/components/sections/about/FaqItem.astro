---
/**
 * FaqItem Component
 *
 * Accordion-style FAQ item with question and answer.
 * Variant A design with generous padding and shadow.
 * Uses button/div pattern with ARIA for accessibility.
 *
 * Uses CSS Grid transition (grid-template-rows: 0fr -> 1fr) for smooth
 * height animation without JavaScript height calculations.
 */

import Text from "../../ui/Text.astro";
import Icon from "../../ui/Icon.astro";
import PortableTextRenderer from "../../PortableText.astro";

interface Props {
  question?: string | any[];
  answer?: string | any[];
  id: string;
}

const { question, answer, id } = Astro.props;

// Helper to check if value is PortableText (array of blocks)
const isPortableText = (value: unknown): value is any[] => Array.isArray(value);

// Extract plain text from PortableText for simple display
const getPlainText = (value: string | any[] | undefined): string => {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) {
    return value
      .filter((block) => block._type === "block")
      .map((block) => block.children?.map((child: any) => child.text).join("") || "")
      .join(" ");
  }
  return "";
};

const contentId = `${id}-content`;
---

<div class="rounded-2xl bg-white shadow-lg" data-accordion-item>
  <button
    type="button"
    class="w-full flex items-center justify-between gap-4 px-8 py-6 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-turquoise focus-visible:ring-inset"
    aria-expanded="false"
    aria-controls={contentId}
    data-accordion-trigger
  >
    <Text as="span" variant="headingSm" class="text-lg font-semibold text-navy">
      {getPlainText(question) || "Question"}
    </Text>
    <span
      class="flex-shrink-0 text-turquoise transition-transform duration-300 ease-out"
      aria-hidden="true"
      data-accordion-icon
    >
      <Icon name="chevron-down" size={24} />
    </span>
  </button>

  <!-- Grid wrapper for smooth height transition -->
  <div
    id={contentId}
    role="region"
    aria-labelledby={id}
    class="accordion-content grid transition-[grid-template-rows] duration-300 ease-out"
    data-accordion-content
  >
    <!-- Inner wrapper with overflow hidden for the animation -->
    <div class="overflow-hidden">
      <div class="px-8 pb-6">
        {isPortableText(answer) ? (
          <PortableTextRenderer value={answer} class="richtext text-gray-600 leading-relaxed" />
        ) : (
          <Text as="p" variant="body" class="text-gray-600 leading-relaxed">
            {answer || "Answer"}
          </Text>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  /* Rotate chevron when expanded */
  [aria-expanded="true"] [data-accordion-icon] {
    transform: rotate(180deg);
  }

  /* CSS Grid height animation technique */
  .accordion-content {
    grid-template-rows: 0fr;
  }

  .accordion-content[data-expanded="true"] {
    grid-template-rows: 1fr;
  }

  /* The direct child needs min-height: 0 for the grid animation to work */
  .accordion-content > div {
    min-height: 0;
  }
</style>
