---
/**
 * FaqItem Component
 *
 * Accordion-style FAQ item with question and answer.
 * Uses HTML details/summary for native accordion behavior.
 * Supports both plain strings and PortableText for question/answer.
 */

import Text from "../../ui/Text.astro";
import Icon from "../../ui/Icon.astro";
import PortableTextRenderer from "../../PortableText.astro";

interface Props {
  question?: string | any[];
  answer?: string | any[];
}

const { question, answer } = Astro.props;

// Helper to check if value is PortableText (array of blocks)
const isPortableText = (value: unknown): value is any[] => Array.isArray(value);

// Extract plain text from PortableText for simple display
const getPlainText = (value: string | any[] | undefined): string => {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) {
    return value
      .filter((block) => block._type === "block")
      .map((block) => block.children?.map((child: any) => child.text).join("") || "")
      .join(" ");
  }
  return "";
};
---

<details class="group border-b border-gray-200 py-4">
  <summary
    class="flex cursor-pointer items-center justify-between gap-4 list-none"
    aria-label={`${getPlainText(question) || "Question"} - Click to expand or collapse`}
  >
    <Text as="span" variant="headingSm" class="text-left">
      {getPlainText(question) || "Question"}
    </Text>
    <span
      class="flex-shrink-0 text-turquoise transition-transform duration-200 group-open:rotate-180"
      aria-hidden="true"
    >
      <Icon name="chevron-down" size={24} />
    </span>
  </summary>
  <div class="pt-4 pb-2" role="region" aria-label="Answer">
    {isPortableText(answer) ? (
      <PortableTextRenderer value={answer} class="richtext text-gray-600" />
    ) : (
      <Text as="p" variant="body" class="text-gray-600">
        {answer || "Answer"}
      </Text>
    )}
  </div>
</details>

<style>
  /* Hide default marker */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
