---
/**
 * FaqItem Component
 *
 * Accordion-style FAQ item with question and answer.
 * Variant A design with generous padding and shadow.
 * Uses button/div pattern with ARIA for accessibility.
 *
 * Uses CSS Grid transition (grid-template-rows: 0fr -> 1fr) for smooth
 * height animation without JavaScript height calculations.
 */

import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";

interface Props {
  question?: string | any[];
  answer?: string | any[];
  id: string;
}

const { question, answer, id } = Astro.props;

// Helper to check if value is PortableText (array of blocks)
const isPortableText = (value: unknown): value is any[] => Array.isArray(value);

// Extract plain text from PortableText for simple display
const getPlainText = (value: string | any[] | undefined): string => {
  if (typeof value === "string") return value;
  if (Array.isArray(value)) {
    return value
      .filter((block) => block._type === "block")
      .map(
        (block) =>
          block.children?.map((child: any) => child.text).join("") || "",
      )
      .join(" ");
  }
  return "";
};

const contentId = `${id}-content`;
---

<div class="border-b border-gray-200" data-accordion-item>
  <button
    type="button"
    class="w-full flex items-center justify-between gap-4 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-turquoise focus-visible:ring-offset-2 rounded-sm group"
    aria-expanded="false"
    aria-controls={contentId}
    data-accordion-trigger
  >
    <Text as="span" variant="body" class="font-medium text-navy group-hover:text-turquoise transition-colors">
      {getPlainText(question) || "Question"}
    </Text>
    <span
      class="shrink-0 h-6 w-6 flex items-center justify-center text-turquoise"
      aria-hidden="true"
      data-accordion-icon
    >
      <svg class="h-4 w-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="8" y1="3" x2="8" y2="13" class="accordion-vertical transition-opacity duration-200" />
        <line x1="3" y1="8" x2="13" y2="8" />
      </svg>
    </span>
  </button>

  <!-- Grid wrapper for smooth height transition -->
  <div
    id={contentId}
    role="region"
    aria-labelledby={id}
    class="accordion-content grid transition-[grid-template-rows] duration-300 ease-out"
    data-accordion-content
  >
    <!-- Inner wrapper with overflow hidden for the animation -->
    <div class="overflow-hidden">
      <div class="pb-5">
        {
          isPortableText(answer) ? (
            <RichText content={answer} class="richtext--muted" />
          ) : (
            <Text as="p" variant="body" tone="muted">
              {answer || "Answer"}
            </Text>
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  /* Hide vertical line when expanded (plus becomes minus) */
  [aria-expanded="true"] .accordion-vertical {
    opacity: 0;
  }

  /* CSS Grid height animation technique */
  .accordion-content {
    grid-template-rows: 0fr;
  }

  .accordion-content[data-expanded="true"] {
    grid-template-rows: 1fr;
  }

  /* The direct child needs min-height: 0 for the grid animation to work */
  .accordion-content > div {
    min-height: 0;
  }
</style>
