---
/**
 * TeamSection Component
 *
 * Community Focus block + Team intro + team member grid.
 */

import { Image } from "astro:assets";
import Section from "../../layout/Section.astro";
import TeamMemberCard from "./TeamMemberCard.astro";
import SanityImage from "../../content/SanityImage.astro";
import { urlFor } from "../../../lib/sanity/image";
import Text from "../../ui/Text.astro";
import linkedinTurquoise from "../../../assets/linkedin-turquoise.svg";

interface TeamMember {
  name?: string;
  title?: string;
  headshot?: any;
  bio?: string;
  linkedinUrl?: string;
}

interface Props {
  communityEyebrow?: string;
  communityHeading?: string;
  communityIntro?: string;
  communityImage?: any;
  teamHeading?: string;
  teamIntro?: string;
  members?: TeamMember[];
}

const {
  communityEyebrow,
  communityHeading,
  communityIntro,
  communityImage,
  teamHeading,
  teamIntro,
  members = [],
} = Astro.props;

const modalFallbackMember = members.find((member) => member?.headshot?.asset);
const modalFallbackSrc = modalFallbackMember?.headshot?.asset
  ? urlFor(modalFallbackMember.headshot).width(400).url()
  : "/favicon.svg";
---

<Section size="lg" tone="muted">
  <div class="grid gap-10 lg:grid-cols-2 items-start">
    <div>
      {
        communityEyebrow && (
          <Text as="p" variant="small" class="uppercase tracking-[0.2em]">
            {communityEyebrow}
          </Text>
        )
      }
      <Text
        as="h2"
        variant="headingLg"
        class={communityEyebrow ? "mt-3" : undefined}
      >
        {communityHeading || "Community Focus"}
      </Text>
      {
        communityIntro && (
          <Text
            as="p"
            variant="body"
            tone="muted"
            class="mt-4 whitespace-pre-line"
          >
            {communityIntro}
          </Text>
        )
      }
    </div>

    {
      communityImage?.asset && (
        <div>
          <SanityImage
            image={communityImage}
            alt={communityImage?.alt || ""}
            width={900}
            class="w-full aspect-4/3 rounded-2xl object-cover"
          />
        </div>
      )
    }
  </div>
</Section>

<Section size="lg" tone="default">
  <div>
    <Text as="h3" variant="headingLg">
      {teamHeading || "Our Team"}
    </Text>
    {
      teamIntro && (
        <Text
          as="p"
          variant="body"
          tone="muted"
          class="mt-4 max-w-5xl md:text-lg"
        >
          {teamIntro}
        </Text>
      )
    }
    {
      members.length > 0 && (
        <div class="grid gap-6 py-8 md:grid-cols-2 md:py-10 lg:grid-cols-3 lg:py-12 xl:grid-cols-5">
          {members.map((member, index) => (
            <TeamMemberCard
              name={member.name}
              title={member.title}
              headshot={member.headshot}
              bio={member.bio}
              linkedinUrl={member.linkedinUrl}
              id={`team-member-${index}`}
            />
          ))}
        </div>
      )
    }
  </div>
</Section>

{/* Modal for team member bio */}
<div
  id="team-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 px-4 pb-6 pt-24 md:pt-28"
  role="dialog"
  aria-modal="true"
  aria-labelledby="team-modal-title"
  data-team-modal
>
  <div
    class="relative w-full max-w-3xl max-h-[calc(100dvh-8rem)] overflow-y-auto rounded-2xl bg-white p-8 shadow-xl"
    data-modal-content
  >
    <button
      type="button"
      class="absolute top-4 right-4 p-2 text-gray-400 hover:text-navy transition-colors cursor-pointer pointer-events-auto"
      aria-label="Close dialog"
      data-modal-close
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="text-center">
      <div
        class="mx-auto mb-4 h-32 w-32 overflow-hidden rounded-full ring-4 ring-turquoise/30"
      >
        <Image
          id="modal-image"
          src={modalFallbackSrc}
          alt=""
          width={400}
          height={400}
          class="h-full w-full object-cover"
        />
      </div>

      <h3 id="team-modal-title" class="text-xl font-bold text-navy"></h3>
      <div class="mt-1 flex items-center justify-center gap-2">
        <p id="modal-title" class="text-turquoise font-medium"></p>
        <a
          id="modal-linkedin"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden"
          aria-label="LinkedIn profile"
        >
          <Image
            src={linkedinTurquoise}
            alt="LinkedIn"
            width={20}
            height={20}
            class="h-5 w-5 hover:opacity-80 transition-opacity"
          />
        </a>
      </div>
      <p id="modal-bio" class="mt-4 text-gray-600 text-left"></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.querySelector("[data-team-modal]");
    const closeButton = modal?.querySelector("[data-modal-close]");
    const cards = document.querySelectorAll("[data-team-card]");

    if (!modal || !closeButton) return;

    const modalImage = document.getElementById("modal-image");
    const modalName = document.getElementById("team-modal-title");
    const modalTitle = document.getElementById("modal-title");
    const modalBio = document.getElementById("modal-bio");
    const modalLinkedin = document.getElementById("modal-linkedin");

    const focusableSelector =
      'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';
    let previousFocus = null;

    const openModal = (card) => {
      if (modalName) modalName.textContent = card.dataset.name || "";
      if (modalTitle) modalTitle.textContent = card.dataset.title || "";
      if (modalBio) modalBio.textContent = card.dataset.bio || "";
      if (modalImage) {
        modalImage.src = card.dataset.image || "";
        modalImage.alt = card.dataset.name || "";
      }
      if (modalLinkedin) {
        const linkedinUrl = card.dataset.linkedin;
        if (linkedinUrl) {
          modalLinkedin.href = linkedinUrl;
          modalLinkedin.classList.remove("hidden");
        } else {
          modalLinkedin.classList.add("hidden");
        }
      }

      previousFocus = document.activeElement;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      closeButton.focus();
    };

    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      if (previousFocus) previousFocus.focus();
    };

    cards.forEach((card) => {
      card.onclick = () => openModal(card);
      card.onkeydown = (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openModal(card);
        }
      };
    });

    closeButton.onclick = closeModal;
    modal.onclick = (e) => {
      if (e.target === modal) closeModal();
    };
    modal.onkeydown = (e) => {
      if (e.key === "Escape") closeModal();
      if (e.key !== "Tab") return;

      const focusableElements = modal.querySelectorAll(focusableSelector);
      if (!focusableElements.length) return;

      const first = focusableElements[0];
      const last = focusableElements[focusableElements.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
  });
</script>
