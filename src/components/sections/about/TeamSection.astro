---
/**
 * TeamSection Component
 *
 * Displays a grid of team members with AlternateTextLayout Variant C intro.
 * Features headline, 2-column text, navy sidebar box, and team grid.
 */

import { Image } from "astro:assets";
import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import TeamMemberCard from "./TeamMemberCard.astro";
import SanityImage from "../../content/SanityImage.astro";
import { urlFor } from "../../../lib/sanity/image";

interface TeamMember {
  name?: string;
  title?: string;
  headshot?: any;
  bio?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  sidebarTitle?: string;
  sidebarContent?: string;
  image?: any;
  members?: TeamMember[];
}

const { eyebrow, heading, intro, sidebarTitle, sidebarContent, image, members = [] } = Astro.props;

const hasSidebar = sidebarTitle || sidebarContent;

const modalFallbackMember = members.find((member) => member?.headshot?.asset);
const modalFallbackSrc = modalFallbackMember?.headshot?.asset
  ? urlFor(modalFallbackMember.headshot).width(400).url()
  : "/favicon.svg";
---

<Section size="lg" tone="muted">
  {/* AlternateTextLayout Variant C intro */}
  <div class="space-y-8 mb-12">
    {/* Main content area with floating image */}
    <div>
      {/* Inline floating image - right side */}
      {image?.asset && (
        <div class="float-right ml-8 mb-4 w-2/5 hidden lg:block rounded-lg overflow-hidden shadow-lg">
          <div class="aspect-[4/3]">
            <SanityImage
              image={image}
              alt={image?.alt || ""}
              width={600}
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      )}

      {/* Eyebrow + Headline */}
      {eyebrow && (
        <p class="text-turquoise font-bold tracking-wide uppercase text-sm mb-3">
          {eyebrow}
        </p>
      )}
      <h2 class="text-2xl md:text-3xl font-bold text-navy leading-tight mb-6">
        {heading || "Our Team"}
      </h2>

      {/* Main content - 2 columns on lg */}
      {intro && (
        <div class="text-base text-gray-600 leading-relaxed columns-1 lg:columns-2 gap-8">
          {intro}
        </div>
      )}
    </div>

    {/* Navy sidebar box */}
    {hasSidebar && (
      <aside class="bg-navy text-white rounded-lg p-6">
        {sidebarTitle && (
          <h3 class="text-lg font-bold text-white mb-3">{sidebarTitle}</h3>
        )}
        {sidebarContent && (
          <p class="text-white/80 leading-relaxed text-sm">{sidebarContent}</p>
        )}
      </aside>
    )}
  </div>

  {/* Team grid */}
  {members.length > 0 && (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {members.map((member, index) => (
        <TeamMemberCard
          name={member.name}
          title={member.title}
          headshot={member.headshot}
          bio={member.bio}
          id={`team-member-${index}`}
        />
      ))}
    </div>
  )}
</Section>

{/* Modal for team member bio */}
<div
  id="team-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50"
  role="dialog"
  aria-modal="true"
  aria-labelledby="team-modal-title"
  data-team-modal
>
  <div class="relative w-full max-w-lg rounded-2xl bg-white p-8 shadow-xl" data-modal-content>
    <button
      type="button"
      class="absolute top-4 right-4 p-2 text-gray-400 hover:text-navy transition-colors"
      aria-label="Close dialog"
      data-modal-close
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="text-center">
      <div class="mx-auto mb-4 h-32 w-32 overflow-hidden rounded-full ring-4 ring-turquoise/30">
        <Image
          id="modal-image"
          src={modalFallbackSrc}
          alt=""
          width={400}
          height={400}
          class="h-full w-full object-cover"
        />
      </div>

      <h3 id="team-modal-title" class="text-xl font-bold text-navy"></h3>
      <p id="modal-title" class="mt-1 text-turquoise font-medium"></p>
      <p id="modal-bio" class="mt-4 text-gray-600 text-left"></p>
    </div>
  </div>
</div>

<script>
  /**
   * Team Modal Controller
   * Opens modal on card click, handles keyboard navigation and focus trap
   */
  (function() {
    const modal = document.querySelector('[data-team-modal]') as HTMLElement;
    const modalContent = modal?.querySelector('[data-modal-content]');
    const closeButton = modal?.querySelector('[data-modal-close]');
    const cards = document.querySelectorAll('[data-team-card]');

    if (!modal || !modalContent || !closeButton) return;

    const modalImage = document.getElementById('modal-image') as HTMLImageElement;
    const modalName = document.getElementById('team-modal-title');
    const modalTitle = document.getElementById('modal-title');
    const modalBio = document.getElementById('modal-bio');

    let previousFocusedElement: HTMLElement | null = null;

    function openModal(card: Element) {
      const name = card.getAttribute('data-name') || '';
      const title = card.getAttribute('data-title') || '';
      const bio = card.getAttribute('data-bio') || '';
      const image = card.getAttribute('data-image') || '';

      if (modalName) modalName.textContent = name;
      if (modalTitle) modalTitle.textContent = title;
      if (modalBio) modalBio.textContent = bio;
      if (modalImage) {
        modalImage.src = image;
        modalImage.srcset = '';
        modalImage.alt = name;
      }

      previousFocusedElement = document.activeElement as HTMLElement;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      // Focus the close button
      (closeButton as HTMLElement).focus();
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');

      // Restore focus
      if (previousFocusedElement) {
        previousFocusedElement.focus();
        previousFocusedElement = null;
      }
    }

    // Open modal on card click
    cards.forEach((card) => {
      card.addEventListener('click', () => openModal(card));

      // Also handle Enter/Space for keyboard users
      card.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          openModal(card);
        }
      });
    });

    // Close on close button click
    closeButton.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Focus trap
    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;

      const focusableElements = modalContent.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    });
  })();
</script>
