---
/**
 * AboutSidebarSection Component
 *
 * Main content with sidebar panel and optional image placements.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Props {
  section?: any;
}

const { section } = Astro.props;

const background = section?.background === "gray" ? "gray" : "white";
const tone = background === "gray" ? "muted" : "default";
const imagePosition = section?.imagePosition || "sidebar";
const hasImage = Boolean(section?.image);
const showSidebarImage = hasImage && imagePosition === "sidebar";
const showFullWidthImage = hasImage && imagePosition === "full-width";
const showInlineImage = hasImage && imagePosition === "inline";
---

<Section size="lg" tone={tone}>
  <div class="space-y-10">
    {
      showFullWidthImage && (
        <SanityImage
          image={section.image}
          alt={section?.image?.alt || ""}
          width={1400}
          class="w-full aspect-[16/9] rounded-2xl object-cover"
        />
      )
    }

    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div>
        {
          section?.headline && (
            <Text as="h2" variant="headingLg">
              {section.headline}
            </Text>
          )
        }
        {
          showInlineImage && (
            <div class="mt-6">
              <SanityImage
                image={section.image}
                alt={section?.image?.alt || ""}
                width={900}
                class="w-full aspsect-4/3 rounded-2xl object-cover"
              />
            </div>
          )
        }
        {
          section?.content && (
            <div class={section?.headline ? "mt-4" : undefined}>
              <RichText content={section.content} />
            </div>
          )
        }
      </div>

      <aside class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
        {
          section?.sidebar?.title && (
            <Text as="h3" variant="headingSm">
              {section.sidebar.title}
            </Text>
          )
        }
        {
          showSidebarImage && (
            <div class="mt-4">
              <SanityImage
                image={section.image}
                alt={section?.image?.alt || ""}
                width={600}
                class="w-full aspsect-4/3 rounded-xl object-cover"
              />
            </div>
          )
        }
        {
          section?.sidebar?.content && (
            <div
              class={
                section?.sidebar?.title || showSidebarImage ? "mt-4" : undefined
              }
            >
              <RichText content={section.sidebar.content} />
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Section>
