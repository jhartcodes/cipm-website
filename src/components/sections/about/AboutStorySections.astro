---
/**
 * AboutStorySections Component
 *
 * Switchboard for About story sections.
 */

import AboutRichTextSection from "./AboutRichTextSection.astro";
import AboutSidebarSection from "./AboutSidebarSection.astro";
import AboutSplitImageSection from "./AboutSplitImageSection.astro";
import AboutFeatureListSection from "./AboutFeatureListSection.astro";

interface Props {
  sections?: any[];
}

const { sections } = Astro.props;
const safeSections = Array.isArray(sections) ? sections : [];
---

{safeSections.map((section) => {
  switch (section?._type) {
    case "aboutRichTextSection":
      return <AboutRichTextSection section={section} key={section?._key} />;
    case "aboutSidebarSection":
      return <AboutSidebarSection section={section} key={section?._key} />;
    case "aboutSplitImageSection":
      return <AboutSplitImageSection section={section} key={section?._key} />;
    case "aboutFeatureListSection":
      return <AboutFeatureListSection section={section} key={section?._key} />;
    default:
      return null;
  }
})}
