---
/**
 * AboutRichTextSection Component
 *
 * Supports centered or two-column layouts with optional eyebrow.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";

interface Props {
  section?: any;
}

const { section } = Astro.props;

const layout = section?.layout === "centered" ? "centered" : "twoColumn";
const background = section?.background === "gray" ? "gray" : "white";
const tone = background === "gray" ? "muted" : "default";

const contentClasses = layout === "centered"
  ? "mt-4 max-w-3xl"
  : "lg:mt-2";
---

<Section size="lg" tone={tone} containerSize={layout === "centered" ? "narrow" : "wide"}>
  {layout === "centered" ? (
    <div class="text-center">
      {section?.eyebrow && (
        <Text as="p" variant="small" tone={tone === "muted" ? "muted" : "default"} class="uppercase tracking-[0.2em]">
          {section.eyebrow}
        </Text>
      )}
      {section?.headline && (
        <Text as="h2" variant="headingLg" class={section?.eyebrow ? "mt-3" : undefined}>
          {section.headline}
        </Text>
      )}
      {section?.content && (
        <div class={contentClasses}>
          <RichText content={section.content} class="mx-auto" />
        </div>
      )}
    </div>
  ) : (
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {section?.eyebrow && (
          <Text as="p" variant="small" tone={tone === "muted" ? "muted" : "default"} class="uppercase tracking-[0.2em]">
            {section.eyebrow}
          </Text>
        )}
        {section?.headline && (
          <Text as="h2" variant="headingLg" class={section?.eyebrow ? "mt-3" : undefined}>
            {section.headline}
          </Text>
        )}
      </div>
      <div>
        {section?.content && (
          <div class={contentClasses}>
            <RichText content={section.content} />
          </div>
        )}
      </div>
    </div>
  )}
</Section>
