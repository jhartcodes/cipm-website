---
/**
 * TeamMemberCard Component
 *
 * Individual team member card with headshot, name, title, and bio.
 */

import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Props {
  name?: string;
  title?: string;
  headshot?: any;
  bio?: string;
}

const { name, title, headshot, bio } = Astro.props;
---

<div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm text-center">
  {headshot && (
    <div class="mx-auto mb-4 h-32 w-32 overflow-hidden rounded-full">
      <SanityImage
        image={headshot}
        alt={headshot?.alt || name || "Team member"}
        width={200}
        class="h-full w-full object-cover"
      />
    </div>
  )}

  {name && (
    <Text as="h3" variant="headingSm">
      {name}
    </Text>
  )}

  {title && (
    <Text as="p" variant="small" class="mt-1 text-turquoise font-medium">
      {title}
    </Text>
  )}

  {bio && (
    <Text as="p" variant="body" class="mt-3 text-gray-600">
      {bio}
    </Text>
  )}
</div>
