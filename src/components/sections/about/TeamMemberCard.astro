---
/**
 * TeamMemberCard Component
 *
 * Individual team member card with circular headshot, name, and title.
 * Variant A clean style with hover ring effect.
 * Clickable to open modal with full bio.
 */

import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";
import { urlFor } from "../../../lib/sanity/image";

interface Props {
  name?: string;
  title?: string;
  headshot?: any;
  bio?: string;
  id: string;
}

const { name, title, headshot, bio, id } = Astro.props;

// Get the image URL for the modal data attribute
const imageUrl = headshot?.asset ? urlFor(headshot).width(400).url() : '';
---

<div
  class="group text-center cursor-pointer"
  tabindex="0"
  role="button"
  aria-label={`View ${name || 'team member'}'s full bio`}
  data-team-card
  data-name={name || ''}
  data-title={title || ''}
  data-bio={bio || ''}
  data-image={imageUrl}
>
  <div class="mx-auto mb-4 h-40 w-40 overflow-hidden rounded-full ring-4 ring-transparent group-hover:ring-turquoise/30 transition-all">
    {headshot?.asset ? (
      <SanityImage
        image={headshot}
        alt={headshot?.alt || name || "Team member"}
        width={200}
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="h-full w-full bg-gray-200 flex items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-16 w-16 text-gray-400"
          aria-hidden="true"
        >
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
      </div>
    )}
  </div>

  {name && (
    <Text as="h3" variant="headingSm" class="text-xl font-bold text-navy group-hover:text-turquoise transition-colors">
      {name}
    </Text>
  )}

  {title && (
    <Text as="p" variant="small" class="mt-1 text-turquoise font-medium">
      {title}
    </Text>
  )}
</div>
