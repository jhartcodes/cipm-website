---
/**
 * TeamMemberCard Component
 *
 * Individual team member card with circular headshot, name, and title.
 * Variant A clean style with hover ring effect.
 * Clickable to open modal with full bio.
 */

import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";
import { urlFor } from "../../../lib/sanity/image";

interface Props {
  name?: string;
  title?: string;
  headshot?: any;
  bio?: string;
  linkedinUrl?: string;
  email?: string;
  id: string;
}

const { name, title, headshot, bio, linkedinUrl, email, id } = Astro.props;
const avatarPlaceholderSrc = "/cube_house.svg";

// Get the image URL for the modal data attribute
const imageUrl = headshot?.asset
  ? urlFor(headshot).width(400).url()
  : avatarPlaceholderSrc;
---

<div
  class="group text-center cursor-pointer"
  tabindex="0"
  role="button"
  aria-label={`View ${name || "team member"}'s full bio`}
  data-team-card
  data-name={name || ""}
  data-title={title || ""}
  data-bio={bio || ""}
  data-image={imageUrl}
  data-linkedin={linkedinUrl || ""}
  data-email={email || ""}
>
  <div
    class="mx-auto mb-4 h-40 w-40 overflow-hidden rounded-full ring-4 ring-transparent group-hover:ring-turquoise/30 transition-all"
  >
    {
      headshot?.asset ? (
        <SanityImage
          image={headshot}
          alt={headshot?.alt || name || "Team member"}
          width={200}
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={avatarPlaceholderSrc}
          alt={
            name
              ? `${name} avatar placeholder`
              : "Team member avatar placeholder"
          }
          class="h-full w-full bg-gray-50 object-contain p-5"
        />
      )
    }
  </div>

  {
    name && (
      <Text
        as="h3"
        variant="headingSm"
        class="text-xl font-bold text-navy group-hover:text-turquoise transition-colors"
      >
        {name}
      </Text>
    )
  }

  {
    title && (
      <Text as="p" variant="small" class="mt-1 text-turquoise font-medium">
        {title}
      </Text>
    )
  }
</div>
