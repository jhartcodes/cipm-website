---
/**
 * ContactCtaSection Component (Shared)
 * todo maybe rename to reusable cta section?
 * Reusable CTA banner for the bottom of pages.
 * Variant C style: turquoise background, compact spacing, white button.
 */

import Container from "../../layout/Container.astro";
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import SanityImage from "../../content/SanityImage.astro";
import { resolveLink } from "../../../lib/routing/resolveLink";

interface Props {
  heading?: string;
  subheading?: string;
  buttonText?: string;
  buttonLink?: any;
  backgroundImage?: any;
}

const { heading, subheading, buttonText, buttonLink, backgroundImage } = Astro.props;

const resolvedHref = resolveLink(buttonLink);
---

<section class="relative overflow-hidden py-12 md:py-16 lg:py-24 bg-turquoise">
  {
    backgroundImage && (
      <div class="absolute inset-0">
        <SanityImage
          image={backgroundImage}
          alt={backgroundImage?.alt || ""}
          width={2400}
          class="w-full h-full object-cover"
        />
      </div>
    )
  }
  <div
    class="absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(78, 165, 194, 1) 0%, rgba(78, 165, 194, 0.65) 100%);"
    aria-hidden="true"
  />
  <Container>
    <div class="relative z-10 text-center">
      <Text as="h2" variant="headingLg" tone="inverted" class="mb-4">
        {heading || "Have a property that needs management?"}
      </Text>

      {
        subheading && (
          <p class="text-white/90 max-w-xl mx-auto mb-8 text-lg leading-relaxed">
            {subheading}
          </p>
        )
      }

      {
        buttonText && resolvedHref && (
          <Button href={resolvedHref} variant="white" size="lg">
            {buttonText}
          </Button>
        )
      }
    </div>
  </Container>
</section>
