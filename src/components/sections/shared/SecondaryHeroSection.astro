---
/**
 * SecondaryHeroSection Component (Shared)
 *
 * Simple, compact hero with gray background and H1 title.
 * Includes decorative turquoise shape and CubeHouse mark that animate on load.
 */

import { Image } from "astro:assets";
import Container from "../../layout/Container.astro";
import Text from "../../ui/Text.astro";
import CubeHouse from "../../../assets/cube-house.svg";

interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<section
  class={`relative overflow-hidden min-h-[30vh] md:min-h-[40vh] lg:min-h-[50vh] max-h-120 bg-gray-50 py-16 lg:py-20 ${className ?? ""}`}
>
  <!-- Decorative turquoise shape -->
  <div
    class="hero-shape absolute -bottom-20 -left-20 w-full h-full bg-turquoise/10 transform -rotate-10 translate-y-1/4"
    aria-hidden="true"
  >
  </div>

  <Container>
    <div class="relative z-10 max-w-3xl">
      <Text as="h1" variant="hero">
        {title}
      </Text>
      {
        subtitle && (
          <div class="subtitle-wrapper mt-6">
            <Text as="p" variant="bodyLg" class="text-navy/70 max-w-2xl">
              {subtitle}
            </Text>
          </div>
        )
      }
    </div>
  </Container>

  <Image
    src={CubeHouse}
    alt=""
    aria-hidden="true"
    class="hero-cube"
    loading="eager"
    width={384}
    height={384}
  />
</section>

<style>
  .hero-shape {
    animation: shape-enter 1s ease-out both;
  }

  .subtitle-wrapper {
    position: relative;
    padding-left: 1rem;
    border-left: 3px solid var(--color-turquoise);
    animation: subtitle-enter 0.8s ease-out 0.3s both;
  }

  .hero-cube {
    position: absolute;
    right: -4%;
    bottom: calc(-10% + 80px);
    width: 10.5rem;
    opacity: 0.9;
    pointer-events: none;
    transform-origin: center;
    animation: cube-enter 1.2s ease-out both;
  }

  @media (min-width: 768px) {
    .hero-cube {
      width: 13.5rem;
      bottom: calc(-12% + 80px);
    }
  }

  @media (min-width: 1024px) {
    .hero-cube {
      width: 18rem;
      bottom: calc(-14% + 80px);
    }
  }

  @keyframes shape-enter {
    0% {
      transform: skewY(-12deg) translate(-500px, 60%);
      opacity: 0;
    }
    100% {
      transform: skewY(-12deg) translate(-300px, 25%);
      opacity: 1;
    }
  }

  @keyframes subtitle-enter {
    0% {
      transform: translateX(-10px);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes cube-enter {
    0% {
      transform: translate(30%, -10%) rotate(-40deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shape {
      animation: none;
      transform: skewY(-12deg) translate(15%, 25%);
    }
    .subtitle-wrapper {
      animation: none;
      transform: translateX(0);
    }
    .hero-cube {
      animation: none;
      transform: translate(0, 0) rotate(0deg);
    }
  }
</style>
