---
/**
 * TopRibbon Component
 *
 * Section Component (Sanity-aware)
 * Optional top bar with contact info
 */

import Container from "../layout/Container.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  data: {
    enabled: boolean;
    phoneNumber?: string;
    email?: string;
    serviceText?: string;
    serviceTextUrl?: string;
  };
}

const { data } = Astro.props;

if (!data?.enabled) {
  return null;
}
---

<div class="bg-navy-dark text-white py-2.5">
  <Container size="wide">
    <div
      class="flex items-center justify-center md:justify-between gap-4 md:gap-8"
    >
      <div class="flex flex-col md:flex-row items-center gap-1 md:gap-6">
        {
          data.phoneNumber && (
            <a
              href={`tel:${data.phoneNumber.replace(/[^0-9+]/g, "")}`}
              class="text-turquoise-light hover:text-white transition-colors text-sm font-medium flex items-center gap-2"
            >
              <Icon name="phone-call" size={16} />
              <span>{data.phoneNumber}</span>
            </a>
          )
        }

        {
          data.email && (
            <a
              href={`mailto:${data.email}`}
              class="text-turquoise-light hover:text-white transition-colors text-sm font-medium flex items-center gap-2"
            >
              <Icon name="mail" size={16} />
              <span>{data.email}</span>
            </a>
          )
        }
      </div>
      {
        data.serviceText && (
          data.serviceTextUrl ? (
            <a
              href={data.serviceTextUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-turquoise-light hover:text-white transition-colors font-medium hidden md:inline"
            >
              {data.serviceText}
            </a>
          ) : (
            <span class="text-sm text-turquoise-light font-medium hidden md:inline">
              {data.serviceText}
            </span>
          )
        )
      }
    </div>
  </Container>
</div>
