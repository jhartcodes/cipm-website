---
/**
 * TopRibbon Component
 *
 * Section Component (Sanity-aware)
 * Optional top bar with contact info
 */

import Container from "../layout/Container.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  data: {
    enabled: boolean;
    phoneNumber?: string;
    email?: string;
  };
}

const { data } = Astro.props;

if (!data?.enabled) {
  return null;
}
---

<div class="bg-navy-dark text-white py-2.5">
  <Container>
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-6">
        {data.phoneNumber && (
          <a
            href={`tel:${data.phoneNumber.replace(/[^0-9+]/g, '')}`}
            class="text-turquoise-light hover:text-white transition-colors text-sm font-medium flex items-center gap-2"
          >
            <Icon name="phone-call" size={16} />
            <span>{data.phoneNumber}</span>
          </a>
        )}

        {data.email && (
          <a
            href={`mailto:${data.email}`}
            class="text-turquoise-light hover:text-white transition-colors text-sm font-medium flex items-center gap-2"
          >
            <Icon name="mail" size={16} />
            <span>{data.email}</span>
          </a>
        )}
      </div>

      <span class="text-sm text-white/60 hidden md:inline">
        Serving Metro Vancouver
      </span>
    </div>
  </Container>
</div>
