---
/**
 * ContactInfoSection Component
 *
 * Displays contact information including heading, address, phone, email, and optional map.
 * Variant A style with generous spacing and turquoise icon circles.
 */

import Text from "../../ui/Text.astro";
import Icon from "../../ui/Icon.astro";
import SmartLink from "../../ui/SmartLink.astro";

interface Props {
  heading?: string;
  address?: string;
  phone?: string;
  email?: string;
  mapEmbedUrl?: string;
}

const { heading, address, phone, email, mapEmbedUrl } = Astro.props;
---

<div class="space-y-8">
  <Text as="h2" variant="heading" class="text-2xl font-bold text-navy mb-6">
    {heading || "How to Reach Us"}
  </Text>

  {phone && (
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-full bg-turquoise/10 flex items-center justify-center flex-shrink-0">
        <Icon name="phone-call" size={20} class="text-turquoise" />
      </div>
      <div>
        <Text as="p" variant="small" class="text-sm text-gray-500 font-medium uppercase tracking-wide">Phone</Text>
        <SmartLink href={`tel:${phone}`} class="text-lg text-navy font-semibold mt-1 hover:text-turquoise transition-colors">
          {phone}
        </SmartLink>
      </div>
    </div>
  )}

  {email && (
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-full bg-turquoise/10 flex items-center justify-center flex-shrink-0">
        <Icon name="mail" size={20} class="text-turquoise" />
      </div>
      <div>
        <Text as="p" variant="small" class="text-sm text-gray-500 font-medium uppercase tracking-wide">Email</Text>
        <SmartLink href={`mailto:${email}`} class="text-lg text-navy font-semibold mt-1 hover:text-turquoise transition-colors">
          {email}
        </SmartLink>
      </div>
    </div>
  )}

  {address && (
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 rounded-full bg-turquoise/10 flex items-center justify-center flex-shrink-0">
        <Icon name="map-pin" size={20} class="text-turquoise" />
      </div>
      <div>
        <Text as="p" variant="small" class="text-sm text-gray-500 font-medium uppercase tracking-wide">Address</Text>
        <Text as="p" variant="body" class="text-lg text-navy font-semibold mt-1 whitespace-pre-line">
          {address}
        </Text>
      </div>
    </div>
  )}

  {mapEmbedUrl && (
    <div class="mt-8 rounded-2xl overflow-hidden h-64">
      <iframe
        src={mapEmbedUrl}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Location map"
      ></iframe>
    </div>
  )}
</div>
