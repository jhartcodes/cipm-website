---
/**
 * ContactInfoSection Component
 *
 * Displays contact information including heading, address, phone, email, and optional map.
 */

import Text from "../../ui/Text.astro";
import Icon from "../../ui/Icon.astro";

interface Props {
  heading?: string;
  address?: string;
  phone?: string;
  email?: string;
  mapEmbedUrl?: string;
}

const { heading, address, phone, email, mapEmbedUrl } = Astro.props;
---

<div>
  <Text as="h2" variant="headingLg">
    {heading || "Get in Touch"}
  </Text>

  <div class="mt-6 space-y-4">
    {address && (
      <div class="flex items-start gap-3">
        <div class="mt-1 flex-shrink-0 text-turquoise">
          <Icon name="map-pin" size={20} />
        </div>
        <div>
          <Text as="p" variant="body" class="font-medium">Address</Text>
          <Text as="p" variant="body" class="text-gray-600 whitespace-pre-line">
            {address}
          </Text>
        </div>
      </div>
    )}

    {phone && (
      <div class="flex items-start gap-3">
        <div class="mt-1 flex-shrink-0 text-turquoise">
          <Icon name="phone-call" size={20} />
        </div>
        <div>
          <Text as="p" variant="body" class="font-medium">Phone</Text>
          <a href={`tel:${phone}`} class="text-gray-600 hover:text-turquoise transition-colors">
            <Text as="span" variant="body">
              {phone}
            </Text>
          </a>
        </div>
      </div>
    )}

    {email && (
      <div class="flex items-start gap-3">
        <div class="mt-1 flex-shrink-0 text-turquoise">
          <Icon name="mail" size={20} />
        </div>
        <div>
          <Text as="p" variant="body" class="font-medium">Email</Text>
          <a href={`mailto:${email}`} class="text-gray-600 hover:text-turquoise transition-colors">
            <Text as="span" variant="body">
              {email}
            </Text>
          </a>
        </div>
      </div>
    )}
  </div>

  {mapEmbedUrl && (
    <div class="mt-8 aspect-video overflow-hidden rounded-xl">
      <iframe
        src={mapEmbedUrl}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Location map"
      ></iframe>
    </div>
  )}
</div>
