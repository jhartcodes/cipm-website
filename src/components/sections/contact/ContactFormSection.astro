---
/**
 * ContactFormSection Component
 *
 * Contact form with Netlify Forms integration.
 * Includes name, email, phone, and message fields.
 */

import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import Icon from "../../ui/Icon.astro";
import TextField from "../../forms/TextField.astro";
import TextArea from "../../forms/TextArea.astro";

interface Props {
  heading?: string;
  description?: string;
  buttonText?: string;
  successMessage?: string;
}

const { heading, description, buttonText, successMessage } = Astro.props;

// Check for success state from URL
const isSuccess = Astro.url.searchParams.get('success') === 'true';
---

<div>
  <Text as="h2" variant="headingLg">
    {heading || "Send us a Message"}
  </Text>

  {description && (
    <Text as="p" variant="body" class="mt-2 text-gray-600">
      {description}
    </Text>
  )}

  {isSuccess ? (
    <div class="mt-6 rounded-lg bg-green-50 border border-green-200 p-6">
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 text-green-600">
          <Icon name="check-circle" size={24} />
        </div>
        <Text as="p" variant="body" class="text-green-800">
          {successMessage || "Thank you for your message! We'll be in touch soon."}
        </Text>
      </div>
    </div>
  ) : (
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/contact?success=true"
      class="mt-6 space-y-4"
    >
      <input type="hidden" name="form-name" value="contact" />

      {/* Honeypot field for spam protection */}
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <TextField
        name="name"
        label="Name"
        type="text"
        required
        placeholder="Your name"
      />

      <TextField
        name="email"
        label="Email"
        type="email"
        required
        placeholder="your@email.com"
      />

      <TextField
        name="phone"
        label="Phone"
        type="tel"
        placeholder="(123) 456-7890"
      />

      <TextArea
        name="message"
        label="Message"
        required
        rows={5}
        placeholder="How can we help you?"
      />

      <div class="pt-2">
        <Button type="submit" variant="primary" size="md">
          {buttonText || "Send Message"}
        </Button>
      </div>
    </form>
  )}
</div>
