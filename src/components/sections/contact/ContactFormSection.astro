---
/**
 * ContactFormSection Component
 *
 * Contact form with server-side API submission.
 * Uses Turnstile + honeypot for bot protection.
 */

import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import Icon from "../../ui/Icon.astro";
import TextField from "../../forms/TextField.astro";
import TextArea from "../../forms/TextArea.astro";

interface Props {
  heading?: string;
  description?: string;
  buttonText?: string;
  successMessage?: string;
}

const { heading, description, buttonText, successMessage } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="space-y-6">
  <Text as="h2" variant="heading" class="text-2xl font-bold text-navy mb-6">
    {heading || "Send us a Message"}
  </Text>

  {description && (
    <Text as="p" variant="body" class="text-gray-600">
      {description}
    </Text>
  )}

  <div class="rounded-xl bg-red-50 border border-red-200 p-6 hidden" data-form-error>
    <Text as="p" variant="body" class="text-red-700" data-form-error-text>
      Unable to submit form right now. Please try again.
    </Text>
  </div>

  <form class="space-y-4" data-lead-form="contact">
    <input type="hidden" name="formId" value="contact" />
    <input type="hidden" name="sourcePage" value="/contact" />

    <p class="hidden" aria-hidden="true">
      <label>
        Leave this field empty
        <input name="honeypot" autocomplete="off" tabindex="-1" />
      </label>
    </p>

    <TextField
      name="name"
      label="Name"
      type="text"
      required
      placeholder="Your name"
    />

    <TextField
      name="email"
      label="Email"
      type="email"
      required
      placeholder="your@email.com"
    />

    <TextField
      name="phone"
      label="Phone"
      type="tel"
      placeholder="(123) 456-7890"
    />

    <TextArea
      name="message"
      label="Message"
      required
      rows={5}
      minLength={10}
      placeholder="How can we help you?"
    />
    <p class="text-sm text-gray-500">Message must be at least 10 characters.</p>

    {
      turnstileSiteKey ? (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="light"
        ></div>
      ) : (
        <p class="text-sm text-red-600">
          Form protection is not configured. Set `PUBLIC_TURNSTILE_SITE_KEY`.
        </p>
      )
    }

    <div class="pt-2">
      <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto" data-submit-button>
        {buttonText || "Send Message"}
      </Button>
    </div>

    <div class="rounded-xl bg-green-50 border border-green-200 p-6 hidden" data-form-success>
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 text-green-600">
          <Icon name="check-circle" size={24} />
        </div>
        <Text as="p" variant="body" class="text-green-800" data-form-success-text>
          {successMessage || "Thank you for your message! We'll be in touch soon."}
        </Text>
      </div>
    </div>
  </form>
</div>

{
  turnstileSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )
}

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector('[data-lead-form="contact"]');
    if (!(form instanceof HTMLFormElement)) return;

    const successBox = document.querySelector("[data-form-success]");
    const successText = document.querySelector("[data-form-success-text]");
    const errorBox = document.querySelector("[data-form-error]");
    const errorText = document.querySelector("[data-form-error-text]");
    const submitButton = form.querySelector("[data-submit-button]");

    const clearMessages = () => {
      successBox?.classList.add("hidden");
      errorBox?.classList.add("hidden");
    };

    const getField = (name: string) => {
      const field = form.querySelector(`[name="${name}"]`);
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        return field;
      }
      return null;
    };

    const clearFieldErrors = () => {
      form
        .querySelectorAll("input, textarea, select")
        .forEach((field) => {
          if (
            field instanceof HTMLInputElement ||
            field instanceof HTMLTextAreaElement ||
            field instanceof HTMLSelectElement
          ) {
            field.setCustomValidity("");
          }
        });
    };

    const applyFieldErrors = (details: Record<string, unknown>) => {
      let applied = false;

      Object.entries(details).forEach(([fieldName, messages]) => {
        if (!Array.isArray(messages)) return;

        const firstMessage = messages.find(
          (value) => typeof value === "string" && value.trim().length > 0,
        );
        if (typeof firstMessage !== "string") return;

        const field = getField(fieldName);
        if (!field) return;

        field.setCustomValidity(firstMessage);
        applied = true;
      });

      if (applied) {
        form.reportValidity();
      }

      return applied;
    };

    form
      .querySelectorAll("input, textarea, select")
      .forEach((field) => {
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement ||
          field instanceof HTMLSelectElement
        ) {
          const clear = () => field.setCustomValidity("");
          field.addEventListener("input", clear);
          field.addEventListener("change", clear);
        }
      });

    const getErrorMessage = (result: any) => {
      if (result?.message === "Invalid form data" && result?.details) {
        const detailValues = Object.values(result.details).flat();
        const firstDetail = detailValues.find(
          (value) => typeof value === "string" && value.trim().length > 0,
        );
        if (typeof firstDetail === "string") return firstDetail;
      }

      if (result?.message === "Turnstile verification failed") {
        return "Please complete the anti-bot check again and resubmit.";
      }

      return result?.message || "Unable to submit form right now. Please try again.";
    };

    const resetTurnstile = () => {
      if (typeof window !== "undefined" && "turnstile" in window) {
        const turnstile = (window as any).turnstile;
        turnstile.reset();
      }
    };

    form.onsubmit = async (event) => {
      event.preventDefault();
      clearMessages();
      clearFieldErrors();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      const formData = new FormData(form);
      const payload = {
        formId: String(formData.get("formId") || "contact"),
        sourcePage: String(formData.get("sourcePage") || "/contact"),
        honeypot: String(formData.get("honeypot") || ""),
        turnstileToken: String(formData.get("cf-turnstile-response") || ""),
        name: String(formData.get("name") || ""),
        email: String(formData.get("email") || ""),
        phone: String(formData.get("phone") || ""),
        message: String(formData.get("message") || ""),
      };

      try {
        const response = await fetch("/api/form-submit", {
          method: "POST",
          headers: {
            "content-type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok || !result?.ok) {
          if (result?.message === "Invalid form data" && result?.details) {
            applyFieldErrors(result.details);
          }
          if (errorText) {
            errorText.textContent = getErrorMessage(result);
          }
          errorBox?.classList.remove("hidden");
          resetTurnstile();
          return;
        }

        if (successText) {
          successText.textContent =
            result?.message || "Thank you for your message! We'll be in touch soon.";
        }
        successBox?.classList.remove("hidden");
        form.reset();

        resetTurnstile();
      } catch (error) {
        console.error("Contact form submit failed", error);
        errorBox?.classList.remove("hidden");
        resetTurnstile();
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    };
  });
</script>
