---
import Text from "../../ui/Text.astro";
import Button from "../../ui/Button.astro";
import Icon from "../../ui/Icon.astro";
import TextField from "../../forms/TextField.astro";
import TextArea from "../../forms/TextArea.astro";

interface PropertyTypeOption {
  _id: string;
  title?: string;
  slug?: { current?: string };
}

interface Props {
  propertyTypes?: PropertyTypeOption[];
  heading?: string;
  description?: string;
  buttonText?: string;
  successMessage?: string;
}

const {
  propertyTypes = [],
  heading,
  description,
  buttonText,
  successMessage,
} = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="space-y-6">
  <div>
    <Text as="h2" variant="heading" class="text-2xl font-bold text-navy">
      {heading || "Request a Proposal"}
    </Text>
    <Text as="p" variant="body" class="mt-2 text-gray-600">
      {description || "Tell us a bit about your property and we will follow up with a proposal."}
    </Text>
  </div>

  <div class="rounded-xl bg-green-50 border border-green-200 p-6 hidden" data-form-success>
    <div class="flex items-center gap-3">
      <div class="flex-shrink-0 text-green-600">
        <Icon name="check-circle" size={24} />
      </div>
      <Text as="p" variant="body" class="text-green-800" data-form-success-text>
        {successMessage || "Thanks for your proposal request. We'll be in touch soon."}
      </Text>
    </div>
  </div>

  <div class="rounded-xl bg-red-50 border border-red-200 p-6 hidden" data-form-error>
    <Text as="p" variant="body" class="text-red-700" data-form-error-text>
      Unable to submit form right now. Please try again.
    </Text>
  </div>

  <form class="space-y-4" data-lead-form="request-proposal">
    <input type="hidden" name="formId" value="request_proposal" />
    <input type="hidden" name="sourcePage" value="/request-proposal" />

    <p class="hidden" aria-hidden="true">
      <label>
        Leave this field empty
        <input name="honeypot" autocomplete="off" tabindex="-1" />
      </label>
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <TextField
        name="name"
        label="Name"
        type="text"
        required
        placeholder="Your name"
      />
      <TextField
        name="email"
        label="Email"
        type="email"
        required
        placeholder="your@email.com"
      />
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <TextField
        name="phone"
        label="Phone"
        type="tel"
        required
        placeholder="(123) 456-7890"
      />
      <div>
        <label for="field-propertyType" class="mb-2 block text-sm font-semibold text-navy">
          Property Type
          <span class="ml-1 text-red-500">*</span>
        </label>
        <select
          id="field-propertyType"
          name="propertyType"
          required
          class="w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-900 transition-all hover:border-gray-400 focus:border-turquoise focus:outline-none focus:ring-2 focus:ring-turquoise/20"
        >
          <option value="">Select a property type</option>
          {
            propertyTypes.map((type) => (
              <option value={type._id}>{type.title || "Untitled"}</option>
            ))
          }
        </select>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <TextField
        name="bestTimeToCall"
        label="Best Time To Call"
        type="text"
        placeholder="Morning / Afternoon / Evening"
      />
      <TextField
        name="buildingSize"
        label="Building Size"
        type="text"
        placeholder="e.g. 15 units or 25,000 sq ft"
      />
    </div>

    <TextField
      name="buildingAddress"
      label="Building Address"
      type="text"
      placeholder="Street, City, Province"
    />

    <TextField
      name="heardAboutUs"
      label="How Did You Hear About Us?"
      type="text"
      placeholder="Referral, Google, Social Media, etc."
    />

    <TextArea
      name="additionalInfo"
      label="Additional Info"
      rows={5}
      placeholder="Anything else we should know?"
    />

    {
      turnstileSiteKey ? (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="light"
        ></div>
      ) : (
        <p class="text-sm text-red-600">
          Form protection is not configured. Set `PUBLIC_TURNSTILE_SITE_KEY`.
        </p>
      )
    }

    <div class="pt-2">
      <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto" data-submit-button>
        {buttonText || "Request Proposal"}
      </Button>
    </div>
  </form>
</div>

{
  turnstileSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )
}

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector('[data-lead-form="request-proposal"]');
    if (!(form instanceof HTMLFormElement)) return;

    const successBox = document.querySelector("[data-form-success]");
    const successText = document.querySelector("[data-form-success-text]");
    const errorBox = document.querySelector("[data-form-error]");
    const errorText = document.querySelector("[data-form-error-text]");
    const submitButton = form.querySelector("[data-submit-button]");

    const clearMessages = () => {
      successBox?.classList.add("hidden");
      errorBox?.classList.add("hidden");
    };

    const resetTurnstile = () => {
      if (typeof window !== "undefined" && "turnstile" in window) {
        const turnstile = (window as any).turnstile;
        turnstile.reset();
      }
    };

    form.onsubmit = async (event) => {
      event.preventDefault();
      clearMessages();

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      const formData = new FormData(form);
      const payload = {
        formId: String(formData.get("formId") || "request_proposal"),
        sourcePage: String(formData.get("sourcePage") || "/request-proposal"),
        honeypot: String(formData.get("honeypot") || ""),
        turnstileToken: String(formData.get("cf-turnstile-response") || ""),
        name: String(formData.get("name") || ""),
        email: String(formData.get("email") || ""),
        phone: String(formData.get("phone") || ""),
        propertyType: String(formData.get("propertyType") || ""),
        bestTimeToCall: String(formData.get("bestTimeToCall") || ""),
        buildingSize: String(formData.get("buildingSize") || ""),
        buildingAddress: String(formData.get("buildingAddress") || ""),
        heardAboutUs: String(formData.get("heardAboutUs") || ""),
        additionalInfo: String(formData.get("additionalInfo") || ""),
      };

      try {
        const response = await fetch("/api/form-submit", {
          method: "POST",
          headers: {
            "content-type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok || !result?.ok) {
          if (errorText) {
            errorText.textContent =
              result?.message || "Unable to submit form right now. Please try again.";
          }
          errorBox?.classList.remove("hidden");
          resetTurnstile();
          return;
        }

        if (successText) {
          successText.textContent =
            result?.message || "Thanks for your proposal request. We'll be in touch soon.";
        }
        successBox?.classList.remove("hidden");
        form.reset();

        resetTurnstile();
      } catch (error) {
        console.error("Request proposal submit failed", error);
        errorBox?.classList.remove("hidden");
        resetTurnstile();
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    };
  });
</script>
