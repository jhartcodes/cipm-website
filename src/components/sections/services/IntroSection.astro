---
/**
 * IntroSection Component
 *
 * Simple intro block with heading and content (PortableText).
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import PortableText from "../../PortableText.astro";

interface Props {
  heading?: string;
  content?: any[];
}

const { heading, content } = Astro.props;
---

<Section size="md">
  <div class="mx-auto max-w-3xl text-center">
    {heading && (
      <Text as="h2" variant="headingLg">
        {heading}
      </Text>
    )}

    {content && (
      <div class="mt-4">
        <PortableText value={content} class="richtext" />
      </div>
    )}
  </div>
</Section>
