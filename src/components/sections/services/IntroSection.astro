---
/**
 * IntroSection Component
 *
 * Simple intro block with heading and content (PortableText).
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import RichText from "../../content/RichText.astro";

interface Props {
  heading?: string;
  content?: any[];
}

const { heading, content } = Astro.props;
---

<Section size="sm">
  <div class="mx-auto max-w-3xl text-center">
    {
      heading && (
        <Text as="h2" variant="headingLg">
          {heading}
        </Text>
      )
    }

    {
      content && (
        <div class="mt-4">
          <RichText content={content} />
        </div>
      )
    }
  </div>
</Section>
