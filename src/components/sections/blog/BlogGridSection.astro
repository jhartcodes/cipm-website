---
/**
 * BlogGridSection Component
 *
 * Displays blog posts in a grid with pagination.
 */

import Section from "../../layout/Section.astro";
import Text from "../../ui/Text.astro";
import Icon from "../../ui/Icon.astro";
import BlogCard from "./BlogCard.astro";

interface Post {
  title?: string;
  slug?: { current?: string };
  excerpt?: string;
  featuredImage?: any;
  category?: Category;
  publishedAt?: string;
  author?: string;
  showAuthor?: boolean;
}

interface Props {
  posts?: Post[];
  currentPage?: number;
  totalPages?: number;
}

const {
  posts = [],
  currentPage = 1,
  totalPages = 1,
} = Astro.props;

// Build pagination URLs
const buildPageUrl = (page: number) => {
  const params = new URLSearchParams();
  if (page > 1) params.set('page', String(page));
  const queryString = params.toString();
  return `/blog${queryString ? `?${queryString}` : ''}`;
};

// Generate truncated page numbers with ellipsis
// Shows: 1 ... 4 5 6 ... 10 (when on page 5)
const getPaginationPages = (current: number, total: number): (number | 'ellipsis')[] => {
  if (total <= 7) {
    // Show all pages if 7 or fewer
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | 'ellipsis')[] = [];

  // Always show first page
  pages.push(1);

  if (current <= 3) {
    // Near the start: 1 2 3 4 ... 10
    for (let i = 2; i <= Math.min(4, total - 1); i++) {
      pages.push(i);
    }
    if (total > 5) pages.push('ellipsis');
  } else if (current >= total - 2) {
    // Near the end: 1 ... 7 8 9 10
    if (total > 5) pages.push('ellipsis');
    for (let i = Math.max(2, total - 3); i <= total - 1; i++) {
      pages.push(i);
    }
  } else {
    // In the middle: 1 ... 4 5 6 ... 10
    pages.push('ellipsis');
    for (let i = current - 1; i <= current + 1; i++) {
      pages.push(i);
    }
    pages.push('ellipsis');
  }

  // Always show last page
  if (total > 1) pages.push(total);

  return pages;
};

const paginationPages = getPaginationPages(currentPage, totalPages);
---

<Section size="lg">
  <div class="min-h-64">
    {posts.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogCard
          title={post.title}
          slug={post.slug}
          excerpt={post.excerpt}
          featuredImage={post.featuredImage}
          category={post.category}
          publishedAt={post.publishedAt}
          author={post.author}
          showAuthor={post.showAuthor}
        />
      ))}
    </div>
  ) : (
    <div class="text-center py-12">
      <Text as="p" variant="body" class="text-gray-500">
        No posts found.
      </Text>
    </div>
  )}

  {totalPages > 1 && (
    <nav class="mt-12 flex justify-center gap-2" aria-label="Pagination">
      {currentPage > 1 && (
        <a
          href={buildPageUrl(currentPage - 1)}
          class="flex items-center gap-1 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
          aria-label="Previous page"
        >
          <Icon name="chevron-left" size={16} />
          Previous
        </a>
      )}

      <div class="flex items-center gap-1">
        {paginationPages.map((page, index) => {
          if (page === 'ellipsis') {
            return (
              <span key={`ellipsis-${index}`} class="flex h-10 w-10 items-center justify-center text-gray-400">
                ...
              </span>
            );
          }
          return (
            <a
              key={page}
              href={buildPageUrl(page)}
              class={`flex h-10 w-10 items-center justify-center rounded-lg text-sm font-medium transition-colors ${
                page === currentPage
                  ? 'bg-turquoise text-white'
                  : 'border border-gray-200 text-gray-700 hover:bg-gray-50'
              }`}
              aria-current={page === currentPage ? 'page' : undefined}
            >
              {page}
            </a>
          );
        })}
      </div>

      {currentPage < totalPages && (
        <a
          href={buildPageUrl(currentPage + 1)}
          class="flex items-center gap-1 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
          aria-label="Next page"
        >
          Next
          <Icon name="chevron-right" size={16} />
        </a>
      )}
    </nav>
  )}
  </div>
</Section>
