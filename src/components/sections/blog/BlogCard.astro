---
/**
 * BlogCard Component
 *
 * Individual blog post card with featured image, category, title, excerpt, and date.
 */

import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Category {
  title?: string;
  slug?: { current?: string };
  color?: string;
}

interface Props {
  title?: string;
  slug?: { current?: string };
  excerpt?: string;
  featuredImage?: any;
  category?: Category;
  publishedAt?: string;
  author?: string;
  showAuthor?: boolean;
}

const { title, slug, excerpt, featuredImage, category, publishedAt, author, showAuthor } = Astro.props;

// Format date
const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;

const postUrl = slug?.current ? `/blog/${slug.current}` : '#';
---

<article class="group bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:border-turquoise transition-colors">
  <a href={postUrl} class="block">
    {featuredImage && (
      <div class="aspect-[16/9] overflow-hidden">
        <SanityImage
          image={featuredImage}
          alt={featuredImage?.alt || title || "Blog post image"}
          width={600}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}

    <div class="p-6">
      {category?.title && (
        <span
          class="inline-block bg-turquoise/10 text-turquoise font-bold text-xs uppercase tracking-wide px-2 py-1 rounded mb-3"
          style={category.color ? `--category-color: ${category.color}` : undefined}
          class:list={[
            category.color && '[background-color:color-mix(in_srgb,var(--category-color)_10%,transparent)] [color:var(--category-color)]'
          ]}
        >
          {category.title}
        </span>
      )}

      {title && (
        <Text as="h3" variant="headingSm" class="text-base font-bold text-navy mb-2 line-clamp-2 group-hover:text-turquoise transition-colors">
          {title}
        </Text>
      )}

      {excerpt && (
        <Text as="p" variant="body" class="text-gray-600 text-sm leading-relaxed mb-3 line-clamp-3">
          {excerpt}
        </Text>
      )}

      {formattedDate && (
        <Text as="time" variant="small" class="text-xs text-gray-400">
          {formattedDate}
        </Text>
      )}

      {showAuthor && author && (
        <Text as="p" variant="small" class="mt-1 text-gray-500">
          By {author}
        </Text>
      )}

      <span class="inline-flex items-center gap-1 text-sm text-turquoise font-bold hover:text-navy transition-colors mt-2">
        Read More →
      </span>
    </div>
  </a>
</article>
