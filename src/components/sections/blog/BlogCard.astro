---
/**
 * BlogCard Component
 *
 * Individual blog post card with featured image, category, title, excerpt, and date.
 */

import Text from "../../ui/Text.astro";
import SanityImage from "../../content/SanityImage.astro";

interface Category {
  title?: string;
  slug?: { current?: string };
  color?: string;
}

interface Props {
  title?: string;
  slug?: { current?: string };
  excerpt?: string;
  featuredImage?: any;
  category?: Category;
  publishedAt?: string;
  author?: string;
  showAuthor?: boolean;
}

const { title, slug, excerpt, featuredImage, category, publishedAt, author, showAuthor } = Astro.props;

// Format date
const formattedDate = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;

const postUrl = slug?.current ? `/blog/${slug.current}` : '#';
---

<article class="group overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-shadow hover:shadow-md">
  <a href={postUrl} class="block">
    {featuredImage && (
      <div class="aspect-[16/9] overflow-hidden">
        <SanityImage
          image={featuredImage}
          alt={featuredImage?.alt || title || "Blog post image"}
          width={600}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}

    <div class="p-5">
      <div class="flex items-center gap-3 text-sm">
        {category?.title && (
          <span
            class="rounded-full px-3 py-1 text-xs font-medium"
            style={category.color ? `background-color: ${category.color}20; color: ${category.color}` : 'background-color: #4A9BA820; color: #4A9BA8'}
          >
            {category.title}
          </span>
        )}
        {formattedDate && (
          <Text as="span" variant="small" class="text-gray-500">
            {formattedDate}
          </Text>
        )}
      </div>

      {title && (
        <Text as="h3" variant="headingSm" class="mt-3 line-clamp-2 group-hover:text-turquoise transition-colors">
          {title}
        </Text>
      )}

      {excerpt && (
        <Text as="p" variant="body" class="mt-2 text-gray-600 line-clamp-3">
          {excerpt}
        </Text>
      )}

      {showAuthor && author && (
        <Text as="p" variant="small" class="mt-3 text-gray-500">
          By {author}
        </Text>
      )}
    </div>
  </a>
</article>
