---
/**
 * Navigation Component
 *
 * Section Component (Sanity-aware)
 * Main site navigation with dynamic menu items and CTA
 */

import { Image } from "astro:assets";
import Container from "../layout/Container.astro";
import SmartLink from "../ui/SmartLink.astro";
import Button from "../ui/Button.astro";
import { resolveLink } from "../../lib/routing/resolveLink";
import logoLongColor from "../../assets/cipm-logo-long-colour.svg";
import cubeHouse from "../../assets/cube-house.svg";

interface MenuItem {
  title: string;
  linkType: "internal" | "external";
  externalUrl?: string;
  internalPage?: {
    _type: string;
    slug?: { current: string };
  };
}

interface Props {
  data: {
    menuItems: MenuItem[];
    showCtaButton?: boolean;
    ctaText?: string;
    ctaLinkType?: "internal" | "external";
    ctaExternalUrl?: string;
    ctaInternalPage?: {
      _type: string;
      slug?: { current: string };
    };
  };
  siteName?: string;
}

const { data, siteName } = Astro.props;
const currentPath = Astro.url.pathname;

const ctaLink = resolveLink({
  linkType: data.ctaLinkType ?? (data.ctaExternalUrl ? "external" : "internal"),
  externalUrl: data.ctaExternalUrl,
  internalPage: data.ctaInternalPage,
});
const showCta = data.showCtaButton && data.ctaText && ctaLink;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-md" transition:animate="none">
  <Container size="wide">
    <nav
      class="flex items-center justify-between h-16"
      aria-label="Main navigation"
    >
      <!-- Logo -->
      <SmartLink href="/" class="flex items-center">
        <!-- Desktop: Full logo -->
        <Image
          src={logoLongColor}
          alt={siteName || "CIPM - Community Impact Property Management"}
          width={180}
          height={30}
          loading="eager"
          class="h-10 w-auto hidden md:block"
        />
        <!-- Mobile: Cube icon only -->
        <Image
          src={cubeHouse}
          alt={siteName || "CIPM"}
          width={260}
          height={310}
          loading="eager"
          class="h-10 w-auto md:hidden"
        />
      </SmartLink>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center gap-8">
        {
          data.menuItems?.map((item) => {
            const href = resolveLink(item);
            const isActive = href === currentPath;

            return (
              <SmartLink
                href={href}
                class:list={[
                  "text-sm font-semibold transition-colors",
                  isActive ? "text-turquoise" : "text-gray-600 hover:text-navy",
                ]}
                ariaCurrent={isActive ? "page" : undefined}
              >
                {item.title}
              </SmartLink>
            );
          })
        }

        {
          showCta && (
            <Button href={ctaLink} variant="secondary" size="md">
              {data.ctaText}
            </Button>
          )
        }
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden p-2 text-navy"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <!-- Hamburger icon (shown when menu closed) -->
        <svg
          class="menu-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 15 15"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M1.5 3C1.22386 3 1 3.22386 1 3.5C1 3.77614 1.22386 4 1.5 4H13.5C13.7761 4 14 3.77614 14 3.5C14 3.22386 13.7761 3 13.5 3H1.5ZM1 7.5C1 7.22386 1.22386 7 1.5 7H13.5C13.7761 7 14 7.22386 14 7.5C14 7.77614 13.7761 8 13.5 8H1.5C1.22386 8 1 7.77614 1 7.5ZM1 11.5C1 11.2239 1.22386 11 1.5 11H13.5C13.7761 11 14 11.2239 14 11.5C14 11.7761 13.7761 12 13.5 12H1.5C1.22386 12 1 11.7761 1 11.5Z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
        <!-- Close icon (shown when menu open) -->
        <svg
          class="menu-icon-close hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 15 15"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M11.7816 4.03157C12.0062 3.80702 12.0062 3.44295 11.7816 3.2184C11.5571 2.99385 11.193 2.99385 10.9685 3.2184L7.50005 6.68682L4.03164 3.2184C3.80708 2.99385 3.44301 2.99385 3.21846 3.2184C2.99391 3.44295 2.99391 3.80702 3.21846 4.03157L6.68688 7.49999L3.21846 10.9684C2.99391 11.193 2.99391 11.557 3.21846 11.7816C3.44301 12.0061 3.80708 12.0061 4.03164 11.7816L7.50005 8.31316L10.9685 11.7816C11.193 12.0061 11.5571 12.0061 11.7816 11.7816C12.0062 11.557 12.0062 11.193 11.7816 10.9684L8.31322 7.49999L11.7816 4.03157Z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu (hidden by default) -->
    <div class="mobile-menu hidden pb-4 md:hidden" id="mobile-menu">
      <div class="flex flex-col gap-4">
        {
          data.menuItems?.map((item) => {
            const href = resolveLink(item);
            const isActive = href === currentPath;

            return (
              <SmartLink
                href={href}
                class:list={[
                  "text-sm font-semibold py-2 transition-colors",
                  isActive ? "text-turquoise" : "text-gray-600 hover:text-navy",
                ]}
                ariaCurrent={isActive ? "page" : undefined}
              >
                {item.title}
              </SmartLink>
            );
          })
        }

        {
          showCta && (
            <Button href={ctaLink} variant="secondary" size="md" class="w-full">
              {data.ctaText}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</header>

<style>
  /* Mobile menu toggle states - scoped to this component */
  .menu-icon-open,
  .menu-icon-close {
    display: block;
  }

  .menu-icon-close.hidden {
    display: none;
  }

  .menu-icon-open.hidden {
    display: none;
  }

  .mobile-menu.hidden {
    display: none;
  }
</style>

<script>
  /**
   * Mobile Menu Controller
   * View Transitions compatible (Navigation uses transition:persist)
   */
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (!button || !menu) return;

    // Skip if already initialized (element persists across navigations)
    if (button.dataset.initialized === 'true') return;
    button.dataset.initialized = 'true';

    const openIcon = button.querySelector('.menu-icon-open');
    const closeIcon = button.querySelector('.menu-icon-close');

    function closeMenu() {
      menu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    }

    function openMenu() {
      menu.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      button.setAttribute('aria-expanded', 'true');
    }

    // Toggle on button click
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      if (menu.classList.contains('hidden')) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    // Close on Escape
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!button.contains(e.target) && !menu.contains(e.target)) {
        closeMenu();
      }
    });

    // Close menu before View Transitions navigation
    document.addEventListener('astro:before-swap', closeMenu);
  });
</script>
