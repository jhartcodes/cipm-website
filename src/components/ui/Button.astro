---
type ButtonVariant = 'primary' | 'secondary' | 'outline' | 'outlineWhite' | 'text' | 'white';
type ButtonSize = 'sm' | 'md' | 'lg';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;

const isLink = !!href && !disabled;

const baseClasses = [
  'inline-flex items-center justify-center gap-2',
  'font-medium leading-normal',
  'rounded-full border-2',
  'cursor-pointer',
  'transition-all duration-200',
  'whitespace-nowrap select-none',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
];

const variantClasses: Record<ButtonVariant, string> = {
  primary: [
    'bg-[var(--color-turquoise)] text-white border-[var(--color-turquoise)]',
    'hover:bg-[#3d8399] hover:border-[#3d8399] hover:-translate-y-px hover:shadow-lg',
    'active:translate-y-0 active:shadow-md active:bg-[#357a8a]',
    'focus-visible:outline-[var(--color-turquoise)]',
  ].join(' '),
  secondary: [
    'bg-[var(--color-navy)] text-white border-[var(--color-navy)]',
    'hover:bg-[#0f2a4f] hover:border-[#0f2a4f] hover:-translate-y-px hover:shadow-lg',
    'active:translate-y-0 active:shadow-md active:bg-[#0a1f3a]',
    'focus-visible:outline-[var(--color-navy)]',
  ].join(' '),
  outline: [
    'bg-transparent text-[var(--color-turquoise)] border-[var(--color-turquoise)]',
    'hover:bg-[var(--color-turquoise)] hover:text-white',
    'active:bg-[#3d8399]',
    'focus-visible:outline-[var(--color-turquoise)]',
  ].join(' '),
  outlineWhite: [
    'bg-transparent text-white border-white',
    'hover:bg-white hover:text-[var(--color-navy)]',
    'active:bg-[var(--color-gray-100)]',
    'focus-visible:outline-white',
  ].join(' '),
  text: [
    'bg-transparent text-[var(--color-turquoise)] border-transparent',
    'hover:text-[var(--color-navy)] hover:underline',
    'active:text-[#0f2a4f]',
    'focus-visible:outline-[var(--color-turquoise)]',
  ].join(' '),
  white: [
    'bg-white text-[var(--color-navy)] border-white',
    'hover:bg-transparent hover:text-white hover:border-white',
    'active:bg-white/10',
    'focus-visible:outline-white',
  ].join(' '),
};

const sizeClasses: Record<ButtonSize, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

// Disabled styles - visual indication only, interaction blocked by disabled attr or missing href
const disabledClasses = 'opacity-50 !cursor-not-allowed';

const classes = [
  ...baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  disabled && disabledClasses,
  className,
].filter(Boolean).join(' ');
---

{isLink ? (
  <a href={href} class={classes} role="button">
    <slot />
  </a>
) : href && disabled ? (
  <a
    class={classes}
    role="button"
    aria-disabled="true"
    tabindex="-1"
  >
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled}>
    <slot />
  </button>
)}
