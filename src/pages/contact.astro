---
/**
 * Contact Page (Production - SSR)
 *
 * SSR to handle form success query param.
 * Fetches published content from Sanity.
 */

import { getSanityClient } from "../lib/sanity/client";
import { CONTACT_PAGE_QUERY } from "../lib/sanity/queries";
import ContactPage from "../components/pages/ContactPage.astro";

// SSR for form handling
export const prerender = false;

// Fetch published content
const client = getSanityClient({ preview: false });
const data = await client.fetch(CONTACT_PAGE_QUERY);
---

<ContactPage data={data} />
