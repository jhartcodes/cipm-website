---
/**
 * Preview Exit Route
 * 
 * Clears preview cookies and redirects to production site
 * URL: /preview-exit?redirect=/path
 */

import { disablePreview } from '../lib/preview/cookies';

export const prerender = false; // SSR only

// Clear preview mode
disablePreview(Astro.cookies);

// Redirect back to production
const redirect = Astro.url.searchParams.get('redirect') || '/';
const productionPath = redirect.startsWith('/p/') 
  ? redirect.replace('/p/', '/') 
  : redirect;

return Astro.redirect(productionPath);
---
