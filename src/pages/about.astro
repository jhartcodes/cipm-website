---
/**
 * About Page
 */

import {
  isVisualEditingEnabledForRequest,
  loadQuery,
} from "../lib/sanity/loadQuery";
import { ABOUT_PAGE_QUERY } from "../lib/sanity/queries";
import AboutPage from "../components/pages/AboutPage.astro";

const visualEditingEnabled = isVisualEditingEnabledForRequest(Astro);
const { data } = await loadQuery({ query: ABOUT_PAGE_QUERY, visualEditingEnabled });
---

<AboutPage data={data} ctaData={data?.ctaData} />
