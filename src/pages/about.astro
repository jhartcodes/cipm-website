---
/**
 * About Page
 */

import { isVisualEditingEnabled, loadQuery } from "../lib/sanity/loadQuery";
import { ABOUT_PAGE_QUERY } from "../lib/sanity/queries";
import AboutPage from "../components/pages/AboutPage.astro";

const visualEditingEnabled = isVisualEditingEnabled({
  url: Astro.url,
  request: Astro.isPrerendered ? undefined : Astro.request,
});
const { data } = await loadQuery({ query: ABOUT_PAGE_QUERY, visualEditingEnabled });
---

<AboutPage data={data} ctaData={data?.ctaData} />
