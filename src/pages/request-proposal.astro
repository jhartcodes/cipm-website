---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import SecondaryHeroSection from "../components/sections/shared/SecondaryHeroSection.astro";
import RequestProposalFormSection from "../components/sections/requestProposal/RequestProposalFormSection.astro";
import { loadQuery } from "../lib/sanity/loadQuery";
import {
  PROPERTY_TYPE_OPTIONS_QUERY,
  REQUEST_PROPOSAL_PAGE_QUERY,
} from "../lib/sanity/queries";

export const prerender = false;

const { data: pageData } = await loadQuery({ query: REQUEST_PROPOSAL_PAGE_QUERY });
const { data: propertyTypes } = await loadQuery({ query: PROPERTY_TYPE_OPTIONS_QUERY });
const pageTitle = pageData?.hero?.heading || "Request Proposal";
---

<BaseLayout title={pageTitle} seo={pageData?.seo}>
  <SecondaryHeroSection
    title={pageTitle}
    subtitle={pageData?.hero?.subheading}
  />

  <Section size="lg">
    <div class="mx-auto max-w-4xl">
      <RequestProposalFormSection
        propertyTypes={propertyTypes || []}
        heading={pageData?.formHeading}
        description={pageData?.formDescription}
        buttonText={pageData?.submitButtonText}
        successMessage={pageData?.successMessage}
      />
    </div>
  </Section>
</BaseLayout>
