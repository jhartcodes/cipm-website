---
import "../styles/global.css";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import Text from "../components/ui/Text.astro";
import Button from "../components/ui/Button.astro";
import RichText from "../components/content/RichText.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Design System Test - CIPM</title>
  </head>
  <body>
    <!-- Header -->
    <Section size="md">
      <header class="text-center">
        <Text as="h1">CIPM Design System</Text>
        <Text as="p" variant="bodyLg" class="text-gray-600">
          Typography & Button Component Testing
        </Text>
      </header>
    </Section>

    <!-- Typography Section -->
    <Section size="md" tone="muted">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Typography
      </Text>

      <div class="space-y-8">
        <!-- Headings -->
        <div>
          <Text as="h1">Heading 1 - Main Page Titles</Text>
          <Text as="h2">Heading 2 - Section Headings</Text>
          <Text as="h3">Heading 3 - Subsection Headings</Text>
          <Text as="h4">Heading 4 - Component Headings</Text>
          <Text as="h5" variant="headingSm">Heading 5 - Small Headings</Text>
          <Text as="h6" variant="headingSm">Heading 6 - Smallest Headings</Text>
        </div>

        <!-- Body Text -->
        <div class="space-y-4">
          <Text as="p" variant="bodyLg">
            Large body text - Used for introductions and emphasis. Lorem ipsum
            dolor sit amet, consectetur adipiscing elit.
          </Text>
          <Text as="p">
            Regular body text - The primary text style for content. Lorem ipsum
            dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
            incididunt ut labore et dolore magna aliqua.
          </Text>
          <Text as="p" variant="small">
            Small text - Used for captions and secondary information.
          </Text>
        </div>

        <!-- Rich Text Demo (simulating CMS content) -->
        <div>
          <Text as="h4" class="mb-4">Rich Text Content (CMS styles)</Text>
          <RichText>
            <p>
              <a href="#">This is a link</a> within regular body text. Links are
              styled with the turquoise color.
            </p>
            <blockquote>
              This is a blockquote. It's styled with a left border and italic
              text, perfect for highlighting quotes or testimonials.
            </blockquote>
            <p><strong>Bold text</strong> and <em>italic text</em> for emphasis.</p>
            <p>Inline <code>code snippets</code> are styled with a subtle background.</p>
            <ul>
              <li>Unordered list item one</li>
              <li>Unordered list item two</li>
              <li>Unordered list item three</li>
            </ul>
            <ol>
              <li>Ordered list item one</li>
              <li>Ordered list item two</li>
              <li>Ordered list item three</li>
            </ol>
          </RichText>
        </div>
      </div>
    </Section>

    <!-- Buttons Section -->
    <Section size="md">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Button System
      </Text>

      <div class="space-y-10">
        <!-- Primary Buttons -->
        <div>
          <Text as="h3">Primary Buttons - Turquoise</Text>
          <Text as="p" variant="small" class="text-gray-600">
            Use for main actions, CTAs, and primary user flows
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="primary">Contact Us Today</Button>
            <Button variant="primary">Learn More</Button>
            <Button variant="primary">Get Started</Button>
          </div>
        </div>

        <!-- Secondary Buttons -->
        <div>
          <Text as="h3">Secondary Buttons - Navy</Text>
          <Text as="p" variant="small" class="text-gray-600">
            Use for important but not primary actions
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="secondary">View Services</Button>
            <Button variant="secondary">Our Team</Button>
          </div>
        </div>

        <!-- Outlined Buttons -->
        <div>
          <Text as="h3">Outlined Buttons - Transparent with Border</Text>
          <Text as="p" variant="small" class="text-gray-600">
            Use for secondary actions or when paired with primary buttons
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="outline">Learn More</Button>
            <Button variant="outline">View Details</Button>
          </div>
        </div>

        <!-- Text Buttons -->
        <div>
          <Text as="h3">Text Buttons - No Background</Text>
          <Text as="p" variant="small" class="text-gray-600">
            Use for tertiary actions, links, and low-emphasis interactions
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="text">Read More »</Button>
            <Button variant="text">View All Posts »</Button>
            <Button variant="text">Cancel</Button>
          </div>
        </div>

        <!-- White CTA Buttons -->
        <div class="bg-navy p-8 rounded-lg">
          <Text as="h3" class="text-white">White CTA Buttons</Text>
          <Text as="p" variant="small" class="text-gray-100">
            Use on dark backgrounds for high contrast CTAs
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="white">Contact Us Today</Button>
            <Button variant="white">Get Started</Button>
          </div>
        </div>

        <!-- Button Sizes -->
        <div>
          <Text as="h3">Button Sizes</Text>
          <div class="flex flex-wrap items-center gap-3 mt-4">
            <Button variant="primary" size="sm">Small Button</Button>
            <Button variant="primary" size="md">Default Button</Button>
            <Button variant="primary" size="lg">Large Button</Button>
          </div>
        </div>

        <!-- Button States -->
        <div>
          <Text as="h3">Button States</Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="primary">Default</Button>
            <Button variant="primary" disabled>Disabled</Button>
          </div>
        </div>

        <!-- Button with Icons -->
        <div>
          <Text as="h3">Buttons with Icons</Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="primary">
              <svg
                width="20"
                height="20"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"></path>
              </svg>
              Email Us
            </Button>
            <Button variant="secondary">
              Download
              <svg
                width="20"
                height="20"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"></path>
              </svg>
            </Button>
          </div>
        </div>

        <!-- Full Width Button -->
        <div>
          <Text as="h3">Full Width Button</Text>
          <Button variant="primary" class="w-full mt-4">
            Full Width CTA Button
          </Button>
        </div>

        <!-- Button as Link -->
        <div>
          <Text as="h3">Button as Link</Text>
          <Text as="p" variant="small" class="text-gray-600">
            Using href prop renders an anchor tag with button styling
          </Text>
          <div class="flex flex-wrap gap-3 mt-4">
            <Button variant="primary" href="/contact">Link to Contact</Button>
            <Button variant="outline" href="/about">Link to About</Button>
          </div>
        </div>
      </div>
    </Section>

    <!-- Color Palette -->
    <Section size="md" tone="muted">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Color Palette
      </Text>

      <div class="space-y-8">
        <div>
          <Text as="h3">Brand Colors</Text>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
            <div>
              <div class="bg-navy h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Navy Blue</strong></Text>
              <Text as="p" variant="small" class="text-gray-600">#15396A</Text>
            </div>
            <div>
              <div class="bg-turquoise h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Turquoise</strong></Text>
              <Text as="p" variant="small" class="text-gray-600">#4EA5C2</Text>
            </div>
            <div>
              <div class="bg-yellow h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Yellow</strong></Text>
              <Text as="p" variant="small" class="text-gray-600">#F2C94C</Text>
            </div>
          </div>
        </div>

        <div>
          <Text as="h3">Neutral Colors</Text>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 mt-4">
            <div>
              <div class="bg-gray-50 h-20 rounded-lg mb-2 border border-gray-100"></div>
              <Text as="p" variant="small"><strong>Gray 50</strong></Text>
              <Text as="span" variant="small" class="text-gray-600">#F4F7FA</Text>
            </div>
            <div>
              <div class="bg-gray-100 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 100</strong></Text>
              <Text as="span" variant="small" class="text-gray-600">#E6EAED</Text>
            </div>
            <div>
              <div class="bg-gray-400 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 400</strong></Text>
              <Text as="span" variant="small" class="text-gray-600">#989898</Text>
            </div>
            <div>
              <div class="bg-gray-600 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 600</strong></Text>
              <Text as="span" variant="small" class="text-gray-600">#565656</Text>
            </div>
            <div>
              <div class="bg-gray-900 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 900</strong></Text>
              <Text as="span" variant="small" class="text-gray-600">#1C2B33</Text>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Accessibility -->
    <Section size="md">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Accessibility & Contrast
      </Text>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div class="bg-navy text-white p-8 rounded-lg text-center">
          <Text as="p" class="text-white"><strong>White on Navy</strong></Text>
          <Text as="p" variant="small" class="text-white">AAA ✓</Text>
        </div>
        <div class="bg-turquoise text-white p-8 rounded-lg text-center">
          <Text as="p" class="text-white"><strong>White on Turquoise</strong></Text>
          <Text as="p" variant="small" class="text-white">AA ✓</Text>
        </div>
        <div class="bg-white text-navy p-8 rounded-lg text-center border-2 border-navy">
          <Text as="p"><strong>Navy on White</strong></Text>
          <Text as="p" variant="small">AAA ✓</Text>
        </div>
      </div>
    </Section>

    <!-- Layout Components Demo -->
    <Section size="lg" tone="inverted">
      <div class="text-center">
        <Text as="h2" class="text-white">Section Component Demo</Text>
        <Text as="p" variant="bodyLg" class="text-gray-100 mt-4">
          This section uses <code class="bg-white/20 px-2 py-1 rounded">tone="inverted"</code> and <code class="bg-white/20 px-2 py-1 rounded">size="lg"</code>
        </Text>
        <div class="flex justify-center gap-4 mt-8">
          <Button variant="white">Primary CTA</Button>
          <Button variant="outlineWhite">Secondary CTA</Button>
        </div>
      </div>
    </Section>

    <!-- Container Sizes Demo -->
    <Section size="sm">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Container Sizes
      </Text>
    </Section>

    <div class="py-4 bg-gray-50">
      <Container size="narrow">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Narrow Container</strong> - max-w-3xl (~768px)
          </Text>
        </div>
      </Container>
    </div>

    <div class="py-4">
      <Container size="base">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Base Container</strong> - max-w-6xl (~1152px) - Default
          </Text>
        </div>
      </Container>
    </div>

    <div class="py-4 bg-gray-50">
      <Container size="wide">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Wide Container</strong> - max-w-7xl (~1280px)
          </Text>
        </div>
      </Container>
    </div>

    <!-- Footer -->
    <Section size="sm" class="border-t border-gray-100">
      <footer class="text-center">
        <Text as="p" variant="small" class="text-gray-600">
          CIPM Design System Test Page - Built with Astro + Tailwind + Component Architecture
        </Text>
      </footer>
    </Section>
  </body>
</html>
