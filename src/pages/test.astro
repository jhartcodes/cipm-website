---
import "../styles/global.css";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import Text from "../components/ui/Text.astro";
import Button from "../components/ui/Button.astro";
import RichText from "../components/content/RichText.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Design System Test - CIPM</title>
  </head>
  <body>
    <!-- Header -->
    <Section size="md">
      <header class="text-center">
        <Text as="h1">CIPM Design System</Text>
        <Text as="p" variant="bodyLg" tone="muted">
          Typography & Button Component Testing
        </Text>
      </header>
    </Section>

    <!-- Typography Section -->
    <Section size="md" tone="muted">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Typography
      </Text>

      <div class="space-y-8">
        <!-- Headings -->
        <div>
          <Text as="h1">Heading 1 - Main Page Titles</Text>
          <Text as="h2">Heading 2 - Section Headings</Text>
          <Text as="h3">Heading 3 - Subsection Headings</Text>
          <Text as="h4">Heading 4 - Component Headings</Text>
          <Text as="h5" variant="headingSm">Heading 5 - Small Headings</Text>
          <Text as="h6" variant="headingSm">Heading 6 - Smallest Headings</Text>
        </div>

        <!-- Body Text -->
        <div class="space-y-4">
          <Text as="p" variant="bodyLg">
            Large body text - Used for introductions and emphasis. Lorem ipsum
            dolor sit amet, consectetur adipiscing elit.
          </Text>
          <Text as="p">
            Regular body text - The primary text style for content. Lorem ipsum
            dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
            incididunt ut labore et dolore magna aliqua.
          </Text>
          <Text as="p" variant="small">
            Small text - Used for captions and secondary information.
          </Text>
        </div>

        <!-- Rich Text Demo (simulating CMS content) -->
        <div>
          <Text as="h4" class="mb-4">Rich Text Content (CMS styles)</Text>
          <RichText>
            <p>
              <a href="#">This is a link</a> within regular body text. Links are
              styled with the turquoise color.
            </p>
            <blockquote>
              This is a blockquote. It's styled with a left border and italic
              text, perfect for highlighting quotes or testimonials.
            </blockquote>
            <p><strong>Bold text</strong> and <em>italic text</em> for emphasis.</p>
            <p>Inline <code>code snippets</code> are styled with a subtle background.</p>
            <ul>
              <li>Unordered list item one</li>
              <li>Unordered list item two</li>
              <li>Unordered list item three</li>
            </ul>
            <ol>
              <li>Ordered list item one</li>
              <li>Ordered list item two</li>
              <li>Ordered list item three</li>
            </ol>
          </RichText>
        </div>
      </div>
    </Section>

    <!-- Buttons Section -->
    <Section size="md">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Button System
      </Text>

      <div class="space-y-10">
        <!-- Usage Guide -->
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
          <Text as="h3" class="mb-4">Usage Guide</Text>
          <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div>
              <Text as="p" variant="small" class="font-bold text-navy mb-1">Light Backgrounds</Text>
              <ul class="text-gray-600 space-y-1">
                <li>• <code class="bg-gray-100 px-1 rounded">primary</code> - Main CTAs (turquoise)</li>
                <li>• <code class="bg-gray-100 px-1 rounded">secondary</code> - Navigation CTAs (navy)</li>
                <li>• <code class="bg-gray-100 px-1 rounded">outline</code> - Secondary actions</li>
                <li>• <code class="bg-gray-100 px-1 rounded">text</code> - Tertiary/low-emphasis</li>
              </ul>
            </div>
            <div>
              <Text as="p" variant="small" class="font-bold text-navy mb-1">Dark/Colored Backgrounds (Inverted)</Text>
              <ul class="text-gray-600 space-y-1">
                <li>• <code class="bg-gray-100 px-1 rounded">white</code> - On turquoise backgrounds</li>
                <li>• <code class="bg-gray-100 px-1 rounded">outlineWhite</code> - On navy backgrounds</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Light Background Buttons -->
        <div>
          <Text as="h3" class="mb-2">Light Background Buttons</Text>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="text">Text Link</Button>
          </div>
        </div>

        <!-- Inverted: Navy Background -->
        <div class="bg-navy p-8 rounded-lg">
          <Text as="h3" tone="inverted" class="mb-2">Navy Background (Inverted)</Text>
          <div class="flex flex-wrap gap-3">
            <Button variant="outlineWhite">Outline White</Button>
            <Button variant="white">White</Button>
          </div>
        </div>

        <!-- Inverted: Turquoise Background (Variant C) -->
        <div class="bg-turquoise p-8 rounded-lg">
          <Text as="h3" tone="inverted" class="mb-2">Turquoise Background (Variant C)</Text>
          <div class="flex flex-wrap gap-3">
            <Button variant="white">White CTA</Button>
          </div>
        </div>

        <!-- Button Sizes -->
        <div>
          <Text as="h3" class="mb-2">Sizes</Text>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="md">Medium</Button>
            <Button variant="primary" size="lg">Large</Button>
          </div>
        </div>

        <!-- Disabled State -->
        <div>
          <Text as="h3" class="mb-2">Disabled State</Text>
          <div class="flex flex-wrap gap-3">
            <Button variant="primary" disabled>Disabled</Button>
            <Button variant="outline" disabled>Disabled Outline</Button>
          </div>
        </div>
      </div>
    </Section>

    <!-- Color Palette -->
    <Section size="md" tone="muted">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Color Palette
      </Text>

      <div class="space-y-8">
        <div>
          <Text as="h3">Brand Colors</Text>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
            <div>
              <div class="bg-navy h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Navy Blue</strong></Text>
              <Text as="p" variant="small">#15396A</Text>
            </div>
            <div>
              <div class="bg-turquoise h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Turquoise</strong></Text>
              <Text as="p" variant="small">#4EA5C2</Text>
            </div>
            <div>
              <div class="bg-yellow h-24 rounded-lg mb-2"></div>
              <Text as="p"><strong>Yellow</strong></Text>
              <Text as="p" variant="small">#F2C94C</Text>
            </div>
          </div>
        </div>

        <div>
          <Text as="h3">Neutral Colors</Text>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 mt-4">
            <div>
              <div class="bg-gray-50 h-20 rounded-lg mb-2 border border-gray-100"></div>
              <Text as="p" variant="small"><strong>Gray 50</strong></Text>
              <Text as="span" variant="small">#F4F7FA</Text>
            </div>
            <div>
              <div class="bg-gray-100 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 100</strong></Text>
              <Text as="span" variant="small">#E6EAED</Text>
            </div>
            <div>
              <div class="bg-gray-400 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 400</strong></Text>
              <Text as="span" variant="small">#989898</Text>
            </div>
            <div>
              <div class="bg-gray-600 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 600</strong></Text>
              <Text as="span" variant="small">#565656</Text>
            </div>
            <div>
              <div class="bg-gray-900 h-20 rounded-lg mb-2"></div>
              <Text as="p" variant="small"><strong>Gray 900</strong></Text>
              <Text as="span" variant="small">#1C2B33</Text>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- Accessibility -->
    <Section size="md">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Accessibility & Contrast
      </Text>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div class="bg-navy text-white p-8 rounded-lg text-center">
          <Text as="p" tone="inverted"><strong>White on Navy</strong></Text>
          <Text as="p" variant="small" tone="inverted">AAA ✓</Text>
        </div>
        <div class="bg-turquoise text-white p-8 rounded-lg text-center">
          <Text as="p" tone="inverted"><strong>White on Turquoise</strong></Text>
          <Text as="p" variant="small" tone="inverted">AA ✓</Text>
        </div>
        <div class="bg-white text-navy p-8 rounded-lg text-center border-2 border-navy">
          <Text as="p"><strong>Navy on White</strong></Text>
          <Text as="p" variant="small">AAA ✓</Text>
        </div>
      </div>
    </Section>

    <!-- Layout Components Demo -->
    <Section size="lg" tone="inverted">
      <div class="text-center">
        <Text as="h2" tone="inverted">Section Component Demo</Text>
        <Text as="p" variant="bodyLg" tone="inverted" class="opacity-80 mt-4">
          This section uses <code class="bg-white/20 px-2 py-1 rounded">tone="inverted"</code> and <code class="bg-white/20 px-2 py-1 rounded">size="lg"</code>
        </Text>
        <div class="flex justify-center gap-4 mt-8">
          <Button variant="white">Primary CTA</Button>
          <Button variant="outlineWhite">Secondary CTA</Button>
        </div>
      </div>
    </Section>

    <!-- Container Sizes Demo -->
    <Section size="sm">
      <Text as="h2" class="border-b-2 border-turquoise pb-2 mb-8">
        Container Sizes
      </Text>
    </Section>

    <div class="py-4 bg-gray-50">
      <Container size="narrow">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Narrow Container</strong> - max-w-3xl (~768px)
          </Text>
        </div>
      </Container>
    </div>

    <div class="py-4">
      <Container size="base">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Base Container</strong> - max-w-6xl (~1152px) - Default
          </Text>
        </div>
      </Container>
    </div>

    <div class="py-4 bg-gray-50">
      <Container size="wide">
        <div class="bg-turquoise/20 p-4 rounded-lg border-2 border-dashed border-turquoise">
          <Text as="p" variant="small" align="center">
            <strong>Wide Container</strong> - max-w-7xl (~1280px)
          </Text>
        </div>
      </Container>
    </div>

    <!-- Footer -->
    <Section size="sm" class="border-t border-gray-100">
      <footer class="text-center">
        <Text as="p" variant="small">
          CIPM Design System Test Page - Built with Astro + Tailwind + Component Architecture
        </Text>
      </footer>
    </Section>
  </body>
</html>
