---
/**
 * Service Detail Page (Dynamic Route)
 */

export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Text from "../../components/ui/Text.astro";
import RichText from "../../components/content/RichText.astro";
import {
  isVisualEditingEnabledForRequest,
  loadQuery,
} from "../../lib/sanity/loadQuery";

const { slug } = Astro.params;
const visualEditingEnabled = isVisualEditingEnabledForRequest(Astro);

const { data: service } = await loadQuery({
  query: `*[_type == "service" && slug.current == $slug][0]{
    title,
    slug,
    shortDescription,
    content,
    image,
    seo
  }`,
  params: { slug },
  visualEditingEnabled,
});

if (!service) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={service.title} seo={service.seo}>
  <Section size="lg" containerSize="narrow">
      <Text as="h1" variant="hero">
        {service.title}
      </Text>

      {service.shortDescription && (
        <Text as="p" variant="bodyLg" class="mt-4 text-gray-600">
          {service.shortDescription}
        </Text>
      )}

      {service.content && (
        <div class="mt-8">
          <RichText content={service.content} />
        </div>
      )}
    </Section>
</BaseLayout>
