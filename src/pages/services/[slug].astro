---
/**
 * Service Detail Page (Static Generation)
 * Only generates pages for services with enableDetailPage: true
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Text from "../../components/ui/Text.astro";
import RichText from "../../components/content/RichText.astro";
import { isVisualEditingEnabled, loadQuery } from "../../lib/sanity/loadQuery";
import {
  buildBreadcrumbStructuredData,
  buildMetaDescription,
} from "../../lib/seo";

export async function getStaticPaths() {
  const { data: services } = await loadQuery<{ slug: { current: string } }[]>({
    query: `*[_type == "service" && enableDetailPage == true]{ "slug": slug.current }`,
    visualEditingEnabled: false,
  });

  return (services || []).map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const visualEditingEnabled = isVisualEditingEnabled({
  url: Astro.url,
  request: Astro.isPrerendered ? undefined : Astro.request,
});

const { data: service } = await loadQuery({
  query: `*[_type == "service" && slug.current == $slug][0]{
    title,
    slug,
    shortDescription,
    content,
    image,
    seo
  }`,
  params: { slug },
  visualEditingEnabled,
});

if (!service) {
  return Astro.redirect("/404");
}

const siteUrl = (
  Astro.site?.toString() || new URL("/", Astro.url).toString()
).replace(/\/$/, "");
const pageDescription =
  buildMetaDescription([service.shortDescription, service.content]) ||
  `${service.title || "Service"} details from CIPM.`;
const structuredData = [
  buildBreadcrumbStructuredData([
    { name: "Home", item: `${siteUrl}/` },
    { name: "Services", item: `${siteUrl}/services` },
    { name: service.title || "Service", item: Astro.url.toString() },
  ]),
].filter(Boolean);
---

<BaseLayout
  title={service.title}
  seo={service.seo}
  description={pageDescription}
  structuredData={structuredData}
>
  <Section size="lg" containerSize="narrow">
    <Text as="h1" variant="hero">
      {service.title}
    </Text>

    {
      service.shortDescription && (
        <Text as="p" variant="bodyLg" class="mt-4 text-gray-600">
          {service.shortDescription}
        </Text>
      )
    }

    {
      service.content && (
        <div class="mt-8">
          <RichText content={service.content} />
        </div>
      )
    }
  </Section>
</BaseLayout>
