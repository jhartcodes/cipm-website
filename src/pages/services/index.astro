---
/**
 * Services Page
 */

import {
  isVisualEditingEnabledForRequest,
  loadQuery,
} from "../../lib/sanity/loadQuery";
import { SERVICES_PAGE_QUERY } from "../../lib/sanity/queries";
import ServicesPage from "../../components/pages/ServicesPage.astro";

const visualEditingEnabled = isVisualEditingEnabledForRequest(Astro);
const { data } = await loadQuery({
  query: SERVICES_PAGE_QUERY,
  visualEditingEnabled,
});
---

<ServicesPage data={data} ctaData={data?.ctaData} />
