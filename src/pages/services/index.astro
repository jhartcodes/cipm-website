---
/**
 * Services Page (Production - Static)
 *
 * Fetches published content from Sanity at build time.
 */

import { getSanityClient } from "../../lib/sanity/client";
import { SERVICES_PAGE_QUERY } from "../../lib/sanity/queries";
import ServicesPage from "../../components/pages/ServicesPage.astro";

// Static generation for production
export const prerender = true;

// Fetch published content
const client = getSanityClient({ preview: false });
const data = await client.fetch(SERVICES_PAGE_QUERY);
---

<ServicesPage data={data} />
