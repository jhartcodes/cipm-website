---
/**
 * Preview Entry Route
 * 
 * Validates preview secret and enables preview mode
 * URL: /preview?secret=xxx&redirect=/path
 */

import { enablePreview } from '../lib/preview/cookies';

export const prerender = false; // SSR only

// Validate query params
const secret = Astro.url.searchParams.get('secret');
const redirect = Astro.url.searchParams.get('redirect') || '/';

// Check if secret matches environment variable
const expectedSecret = import.meta.env.SANITY_PREVIEW_SECRET;

if (!secret || !expectedSecret || secret !== expectedSecret) {
  return new Response('Invalid preview secret', { status: 401 });
}

// Enable preview mode
enablePreview(Astro.cookies, secret);

// Redirect to preview mirror route
const previewPath = redirect.startsWith('/p/') ? redirect : `/p${redirect}`;

return Astro.redirect(previewPath);
---
