---
/**
 * About Page Preview (SSR - Draft Content)
 *
 * Mirror route for previewing draft about page content.
 * Uses the same AboutPage component as production.
 */

import { getSanityClient } from "../../lib/sanity/client";
import { ABOUT_PAGE_QUERY } from "../../lib/sanity/queries";
import { isPreviewMode, validatePreviewSecret } from "../../lib/preview/cookies";
import AboutPage from "../../components/pages/AboutPage.astro";
import PreviewBanner from "../../components/sections/PreviewBanner.astro";

// SSR only for preview
export const prerender = false;

// Validate preview mode
if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect('/preview-exit?redirect=/about');
}

// Fetch draft content
const client = getSanityClient({ preview: true });
const data = await client.fetch(ABOUT_PAGE_QUERY);
---

<PreviewBanner />
<AboutPage data={data} preview={true} />
