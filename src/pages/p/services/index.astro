---
/**
 * Services Page Preview (SSR - Draft Content)
 *
 * Mirror route for previewing draft services page content.
 * Uses the same ServicesPage component as production.
 */

import { getSanityClient } from "../../../lib/sanity/client";
import { SERVICES_PAGE_QUERY } from "../../../lib/sanity/queries";
import { isPreviewMode, validatePreviewSecret } from "../../../lib/preview/cookies";
import ServicesPage from "../../../components/pages/ServicesPage.astro";
import PreviewBanner from "../../../components/sections/PreviewBanner.astro";

// SSR only for preview
export const prerender = false;

// Validate preview mode
if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect('/preview-exit?redirect=/services');
}

// Fetch draft content
const client = getSanityClient({ preview: true });
const data = await client.fetch(SERVICES_PAGE_QUERY);
---

<PreviewBanner />
<ServicesPage data={data} preview={true} />
