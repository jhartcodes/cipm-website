---
/**
 * Service Detail Preview (SSR - Draft Content)
 */

export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/layout/Container.astro";
import Section from "../../../components/layout/Section.astro";
import Text from "../../../components/ui/Text.astro";
import RichText from "../../../components/content/RichText.astro";
import PreviewBanner from "../../../components/sections/PreviewBanner.astro";
import { getSanityClient } from "../../../lib/sanity/client";
import { isPreviewMode, validatePreviewSecret } from "../../../lib/preview/cookies";

const { slug } = Astro.params;

if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect(`/preview-exit?redirect=/services/${slug ?? ""}`);
}

const client = getSanityClient({ preview: true });

const service = await client.fetch(
  `*[_type == "service" && slug.current == $slug][0]{
    title,
    slug,
    shortDescription,
    content,
    image,
    seo
  }`,
  { slug }
);

if (!service) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={service.title} seo={service.seo} preview={true}>
  <PreviewBanner />
  <Section size="xl">
    <Container class="max-w-3xl">
      <Text as="h1" variant="displayLg">
        {service.title}
      </Text>

      {service.shortDescription && (
        <Text as="p" variant="bodyLg" class="mt-4 text-gray-600">
          {service.shortDescription}
        </Text>
      )}

      {service.content && (
        <div class="mt-8">
          <RichText content={service.content} />
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>
