---
/**
 * Home Page Preview (SSR - Draft Content)
 * 
 * Mirror route for previewing draft home page content
 * Uses the same HomePage component as production
 */

import { getSanityClient } from "../../lib/sanity/client";
import { HOME_PAGE_QUERY } from "../../lib/sanity/queries";
import { isPreviewMode, validatePreviewSecret } from "../../lib/preview/cookies";
import HomePage from "../../components/pages/HomePage.astro";
import PreviewBanner from "../../components/sections/PreviewBanner.astro";

// SSR only for preview
export const prerender = false;

// Validate preview mode
if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect('/preview-exit?redirect=/');
}

// Fetch draft content
const client = getSanityClient({ preview: true });
const data = await client.fetch(HOME_PAGE_QUERY);
---

<PreviewBanner />
<HomePage data={data} preview={true} />
