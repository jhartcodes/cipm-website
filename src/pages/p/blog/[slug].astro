---
/**
 * Blog Post Preview (SSR - Draft Content)
 */

export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/layout/Container.astro";
import Section from "../../../components/layout/Section.astro";
import Text from "../../../components/ui/Text.astro";
import RichText from "../../../components/content/RichText.astro";
import PreviewBanner from "../../../components/sections/PreviewBanner.astro";
import { getSanityClient } from "../../../lib/sanity/client";
import { BLOG_POST_QUERY } from "../../../lib/sanity/queries";
import { isPreviewMode, validatePreviewSecret } from "../../../lib/preview/cookies";

const { slug } = Astro.params;

if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect(`/preview-exit?redirect=/blog/${slug ?? ""}`);
}

const client = getSanityClient({ preview: true });
const post = await client.fetch(BLOG_POST_QUERY, { slug });

if (!post) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={post.title} seo={post.seo} preview={true}>
  <PreviewBanner />
  <Section size="xl">
    <Container class="max-w-3xl">
      <Text as="h1" variant="displayLg">
        {post.title}
      </Text>

      {post.publishedAt && (
        <Text as="p" variant="small" class="mt-4 text-gray-500">
          {new Date(post.publishedAt).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </Text>
      )}

      {post.content && (
        <div class="mt-8">
          <RichText content={post.content} />
        </div>
      )}
    </Container>
  </Section>
</BaseLayout>
