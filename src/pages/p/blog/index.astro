---
/**
 * Blog Page Preview (SSR - Draft Content)
 */

export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogPage from "../../../components/pages/BlogPage.astro";
import PreviewBanner from "../../../components/sections/PreviewBanner.astro";
import { isPreviewMode, validatePreviewSecret } from "../../../lib/preview/cookies";

if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect("/preview-exit?redirect=/blog");
}
---

<BaseLayout title="Blog" preview={true}>
  <PreviewBanner />
  <BlogPage />
</BaseLayout>
