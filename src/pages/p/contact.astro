---
/**
 * Contact Page Preview (SSR - Draft Content)
 *
 * Mirror route for previewing draft contact page content.
 * Uses the same ContactPage component as production.
 */

import { getSanityClient } from "../../lib/sanity/client";
import { CONTACT_PAGE_QUERY } from "../../lib/sanity/queries";
import { isPreviewMode, validatePreviewSecret } from "../../lib/preview/cookies";
import ContactPage from "../../components/pages/ContactPage.astro";
import PreviewBanner from "../../components/sections/PreviewBanner.astro";

// SSR only for preview
export const prerender = false;

// Validate preview mode
if (!isPreviewMode(Astro.cookies) || !validatePreviewSecret(Astro.cookies)) {
  return Astro.redirect('/preview-exit?redirect=/contact');
}

// Fetch draft content
const client = getSanityClient({ preview: true });
const data = await client.fetch(CONTACT_PAGE_QUERY);
---

<PreviewBanner />
<ContactPage data={data} preview={true} />
