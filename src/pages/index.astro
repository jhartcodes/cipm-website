---
/**
 * Home Page
 */

import { isVisualEditingEnabled, loadQuery } from "../lib/sanity/loadQuery";
import { HOME_PAGE_QUERY } from "../lib/sanity/queries";
import HomePage from "../components/pages/HomePage.astro";

const visualEditingEnabled = isVisualEditingEnabled({
  url: Astro.url,
  request: Astro.isPrerendered ? undefined : Astro.request,
});
const { data, perspective } = await loadQuery({ query: HOME_PAGE_QUERY, visualEditingEnabled });

// DEBUG: Log Sanity response to Netlify function logs
console.log('=== SANITY DEBUG ===');
console.log('visualEditingEnabled:', visualEditingEnabled);
console.log('perspective:', perspective);
console.log('heroVariant:', data?.heroVariant);
console.log('propertyTypes count:', data?.propertyTypes?.length);
console.log('propertyTypes:', JSON.stringify(data?.propertyTypes?.map((p: any) => p?.title)));
console.log('hero:', JSON.stringify(data?.hero));
console.log('=== END DEBUG ===');
---

<HomePage data={data} ctaData={data?.ctaData} />
