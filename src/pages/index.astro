---
/**
 * Home Page (Production - Static)
 * 
 * Fetches published content from Sanity at build time
 */

import { getSanityClient } from "../lib/sanity/client";
import { HOME_PAGE_QUERY } from "../lib/sanity/queries";
import HomePage from "../components/pages/HomePage.astro";

// Static generation for production
export const prerender = true;

// Fetch published content
const client = getSanityClient({ preview: false });
const data = await client.fetch(HOME_PAGE_QUERY);
---

<HomePage data={data} />
