---
/**
 * Home Page
 *
 * Fetches home page data from Sanity and renders using BaseLayout
 */

// Server-render for preview mode support
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import Text from "../components/ui/Text.astro";
---

<BaseLayout title="Home">
  <Section size="xl">
    <Container>
      <Text as="h1" variant="displayLg" class="text-center">
        Welcome to CIPM
      </Text>
      <Text as="p" variant="body" class="text-center mt-4 text-gray-600">
        Community Impact Property Management
      </Text>
    </Container>
  </Section>
</BaseLayout>
